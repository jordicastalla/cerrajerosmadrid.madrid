# Configuración para hosting Apache (cPanel, Plesk, FTP).
# Astro copia este fichero a dist/ tal cual: sube el CONTENIDO de dist/ a
# public_html y el .htaccess irá dentro, en la raíz del hosting.

Options -Indexes
AddDefaultCharset UTF-8
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS obligatorio, conservando el dominio con el que se ha entrado
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Versión canónica sin www (evita contenido duplicado)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # La página de cambio de cerradura y bombín pasó a ser solo de cambio de cerradura
  RewriteRule ^cambio-cerradura-bombin/?$ /cambio-cerradura/ [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # Los assets de Astro llevan hash en el nombre: caché agresiva sin riesgo
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 month"
  ExpiresByType image/jpeg              "access plus 1 month"
  ExpiresByType image/png               "access plus 1 month"
  ExpiresByType image/webp              "access plus 1 month"
  ExpiresByType image/avif              "access plus 1 month"

  # El HTML debe revalidarse para que los cambios se vean al momento
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Las imágenes no llevan hash en el nombre, así que no pueden ir a un año:
  # cambiar el logotipo dejaría a los visitantes con el viejo. 30 días es el
  # equilibrio. Se pone también aquí, y no solo en mod_expires, porque hay
  # alojamientos que traen ese módulo desactivado y entonces manda el valor
  # por defecto del servidor, que suele ser una semana.
  <FilesMatch "\.(svg|png|jpe?g|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header always unset X-Powered-By
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>
