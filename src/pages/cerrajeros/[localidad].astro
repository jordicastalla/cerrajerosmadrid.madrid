---
/**
 * Plantilla de localidad (spec §28). Misma plantilla, contenido propio: cada
 * sección solo se pinta si la ficha de la empresa tiene datos reales.
 * La puerta de indexación (spec §5) decide noindex, sitemap y enlaces.
 * Los servicios se nombran sin la localidad (v2.2). Bloques comunes de
 * zona (v2.3): ventajas, banner de llamada, «Ten esto a mano», zonas cercanas
 * y preguntas frecuentes (las propias de la ficha y las generales).
 *
 * El texto propio de la ficha se reparte según el esquema del cliente
 * (src/lib/cuerpo-zona.ts): intro corta bajo el H1, intro larga tras el hero,
 * 24 horas tras «Servicios», precios tras «Lo que tienes al llamarnos» y
 * «Llámanos» tras el banner «¿Te has quedado fuera en…?».
 */
import { getCollection, getEntries, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import CallButton from '@components/CallButton.astro';
import EEATBadges from '@components/EEATBadges.astro';
import TrabajosReales from '@components/TrabajosReales.astro';
import InterlinkingGrid from '@components/InterlinkingGrid.astro';
import Faq from '@components/Faq.astro';
import CtaFinal from '@components/CtaFinal.astro';
import Ventajas from '@components/zona/Ventajas.astro';
import BannerLlamada from '@components/zona/BannerLlamada.astro';
import TenAMano from '@components/zona/TenAMano.astro';
import Cercanas from '@components/zona/Cercanas.astro';
import SeccionTexto from '@components/zona/SeccionTexto.astro';
import { trocearCuerpo } from '@lib/cuerpo-zona';
import { comprobarPuerta, esIndexable } from '@lib/gate';
import { casosVerificados } from '@lib/casos';
import { servicio as servicioSchema } from '@lib/schema';
import { faqsGenerales } from '@data/zona';

export async function getStaticPaths() {
  const localidades = await getCollection('localidades', (l) => l.data.cerrajeroPropio);
  const casos = await casosVerificados();
  const porLocalidad = new Map<string, number>();
  for (const c of casos) porLocalidad.set(c.data.localidad.id, (porLocalidad.get(c.data.localidad.id) ?? 0) + 1);

  // Falla el build si alguna localidad está en ready sin cumplir los mínimos
  comprobarPuerta(localidades, porLocalidad);

  return localidades.map((entrada) => ({ params: { localidad: entrada.id }, props: { entrada } }));
}

interface Props {
  entrada: CollectionEntry<'localidades'>;
}

const { entrada } = Astro.props;
const d = entrada.data;
const ruta = `/cerrajeros/${entrada.id}/`;
const indexable = esIndexable(d.status);

// Texto propio de la zona, repartido por la página. Sin cuerpo, no se pinta.
const cuerpo = trocearCuerpo(entrada.id, entrada.body);
const introCorta = cuerpo?.introCorta.length ? cuerpo.introCorta : d.intro ? d.intro.split(/\n{2,}/) : [];

// Foto del pueblo: al lado de la intro larga, justo bajo el hero (no en el hero)
const hayFoto = Boolean(d.image && d.imageAlt);

const servicios = (await getCollection('servicios', (s) => s.data.status === 'ready')).sort((a, b) => a.data.orden - b.data.orden);
const cercanas = (await getEntries(d.nearby)).filter((l) => l.data.cerrajeroPropio);

// Primero las preguntas reales de la zona (ficha); después, las comunes
const faqs = [
  ...d.faqs,
  ...faqsGenerales(
    d.nombre,
    cercanas.map((c) => c.data.nombre),
    { barrios: d.barrios, semilla: entrada.id },
  ),
];
---

<Layout
  titulo={d.seoTitle}
  descripcion={d.seoDescription}
  ruta={ruta}
  noindex={!indexable}
  schemas={[
    servicioSchema({
      nombre: `Cerrajería en ${d.nombre}`,
      descripcion: `Apertura de puertas, cambio de cerraduras e instalación de cerrojos en ${d.nombre}.`,
      ruta,
      area: d.nombre,
    }),
  ]}
>
  <Breadcrumbs
    items={[
      { nombre: 'Inicio', ruta: '/' },
      { nombre: d.nombre, ruta },
    ]}
  />

  <section class="cabeza-loc">
    <div class="envoltura cabeza-loc__rejilla">
      <div>
        <h1 class="titular cabeza-loc__h1"><span class="metal">Cerrajeros en</span> <span class="dorado">{d.nombre}</span></h1>
        {
          introCorta.length > 0 ? (
            <div class="cabeza-loc__intro">
              {introCorta.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          ) : (
            <>
              <p class="cabeza-loc__propio">Uno de nuestros cerrajeros trabaja en {d.nombre}.</p>
              {d.tiempoLlegada && <p class="cabeza-loc__dato">{d.tiempoLlegada}</p>}
            </>
          )
        }
        <div class="cabeza-loc__accion"><CallButton cta={`zona-${entrada.id}`} sub="Servicio 24 horas" /></div>
        <EEATBadges clase="cabeza-loc__insignias" />
      </div>
    </div>
  </section>

  <!-- Intro larga (tras el hero) y Servicios -->
  <div class="claro">
    <div class="envoltura tramo cuerpo-loc">
      {
        cuerpo && (
          <section aria-labelledby="loc-intro" class:list={['cuerpo-loc__intro', { 'cuerpo-loc__intro--foto': hayFoto }]}>
            <div>
              <p class="rotulo">OpenServi en {d.nombre}</p>
              <h2 id="loc-intro" class="seccion__titulo cuerpo-loc__titulo">
                {cuerpo.introLarga.titulo}
              </h2>
              <div class="prosa cuerpo-loc__prosa">
                {cuerpo.introLarga.parrafos.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </div>
            {hayFoto && (
              <figure class="cuerpo-loc__figura">
                <Image
                  src={d.image!}
                  alt={d.imageAlt!}
                  widths={[400, 800, 1200]}
                  sizes="(min-width: 960px) 24rem, min(100vw, 24rem)"
                  class="cuerpo-loc__foto"
                />
                {d.imageCredito && <figcaption class="credito cuerpo-loc__credito">{d.imageCredito}</figcaption>}
              </figure>
            )}
          </section>
        )
      }

      <section aria-labelledby="loc-servicios">
        <h2 id="loc-servicios" class="cuerpo-loc__h2">Servicios</h2>
        <div class="cuerpo-loc__grid">
          <InterlinkingGrid
            items={[
              { href: '/#apertura-de-puertas', titulo: 'Apertura de puertas', texto: 'Si te has quedado fuera, a cualquier hora.' },
              ...servicios.map((s) => ({ href: `/servicios/${s.id}/`, titulo: s.data.titulo, texto: s.data.resumen })),
            ]}
          />
        </div>
      </section>
    </div>
  </div>

  <!-- 24 horas / urgencias (tras Servicios) -->
  {
    cuerpo && (
      <SeccionTexto
        seccion={cuerpo.urgencias}
        id="zona-urgencias"
        rotulo="24 horas, 365 días"
        tono="oscuro"
        cta={`zona-urgencias-${entrada.id}`}
        sub="24 horas, todos los días"
      />
    )
  }

  {
    (d.barrios.length > 0 || d.observacionesLocales.length > 0) && (
      <div class="claro">
        <section aria-labelledby="loc-cobertura" class="envoltura tramo cuerpo-loc__cobertura">
          <h2 id="loc-cobertura" class="cuerpo-loc__h2">
            Dónde trabajamos en {d.nombre}
          </h2>
          {d.barrios.length > 0 && (
            <ul class="cuerpo-loc__barrios">
              {d.barrios.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          )}
          {d.observacionesLocales.length > 0 && (
            <div class="prosa">
              <h3>Lo que vemos a menudo en la zona</h3>
              <ul>
                {d.observacionesLocales.map((o) => (
                  <li>{o}</li>
                ))}
              </ul>
            </div>
          )}
        </section>
      </div>
    )
  }

  <Ventajas nombre={d.nombre} />

  <!-- Precios y calidad (tras «Lo que tienes al llamarnos») -->
  {cuerpo && <SeccionTexto seccion={cuerpo.precios} id="zona-precios" rotulo="Precios claros" tono="claro" />}

  <BannerLlamada nombre={d.nombre} slug={entrada.id} />

  <!-- Llámanos / confianza (tras «¿Te has quedado fuera en…?») -->
  {
    cuerpo && (
      <SeccionTexto
        seccion={cuerpo.llamanos}
        id="zona-llamanos"
        rotulo="Llámanos"
        tono="oscuro"
        cta={`zona-llamanos-${entrada.id}`}
      />
    )
  }

  <TenAMano nombre={d.nombre} consejo={d.consejo} />

  <TrabajosReales localidad={entrada.id} minimo={1} titulo={`Trabajos reales en ${d.nombre}`} />

  <Cercanas nombre={d.nombre} cercanas={cercanas} indexable={indexable} />

  <Faq faqs={faqs} titulo={`Preguntas frecuentes en ${d.nombre}`} id="preguntas" />

  <CtaFinal titulo={`¿Necesitas un cerrajero en ${d.nombre}?`} cta={`final-zona-${entrada.id}`} />
</Layout>

<style>
  .cabeza-loc {
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(3rem, 6vw, 5rem);
    background:
      radial-gradient(40rem 24rem at 85% 20%, rgb(212 175 55 / 0.12), transparent 62%),
      var(--obsidiana-profunda);
  }

  .cabeza-loc__rejilla {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 1000px) {
    .cabeza-loc__rejilla {
      grid-template-columns: minmax(0, 1.3fr) minmax(16rem, 0.7fr);
    }
  }

  .cabeza-loc__h1 {
    font-size: clamp(1.8rem, 1.1rem + 3vw, 3.5rem);
  }

  .cabeza-loc__propio {
    margin-top: 1.1rem;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--blanco);
  }

  .cabeza-loc__dato {
    margin-top: 0.5rem;
    color: var(--plata-2);
  }

  /* Intro corta del cliente, bajo el H1 */
  .cabeza-loc__intro {
    max-width: 40rem;
  }

  .cabeza-loc__intro p {
    margin-top: 1.1rem;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    line-height: 1.6;
    color: var(--plata);
  }

  .cabeza-loc__accion {
    margin-top: 1.75rem;
  }

  :global(.cabeza-loc__insignias) {
    margin-top: 1.75rem !important;
  }

  /* Foto de la zona junto a la intro larga, en vertical (3:4): a la derecha en
     escritorio (fija mientras se lee el texto), debajo del texto en móvil */
  .cuerpo-loc__intro--foto {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .cuerpo-loc__intro--foto {
      grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr);
      gap: 4rem;
    }

    .cuerpo-loc__figura {
      position: sticky;
      top: 6.5rem;
      margin-top: 3.25rem;
    }
  }

  .cuerpo-loc__figura {
    width: min(100%, 24rem);
    margin: 0 auto;
  }

  @media (min-width: 960px) {
    .cuerpo-loc__figura {
      width: 100%;
    }
  }

  :global(.cuerpo-loc__foto) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 50% 40%;
    border-radius: 1rem;
    border: 1px solid var(--linea-oro);
    box-shadow: 0 30px 60px -40px rgb(3 7 18 / 0.7);
  }

  .cuerpo-loc__credito {
    margin-top: 0.6rem;
    text-align: center;
  }

  .cuerpo-loc {
    display: grid;
    gap: 3rem;
  }

  .cuerpo-loc__h2 {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.1rem);
  }

  /* Intro larga del cliente, tras el hero */
  .cuerpo-loc__titulo {
    max-width: 48rem;
    font-size: clamp(1.7rem, 1.25rem + 1.5vw, 2.5rem);
  }

  .cuerpo-loc__prosa {
    max-width: 46rem;
    margin-top: 1.25rem;
  }

  .cuerpo-loc__grid {
    margin-top: 1.5rem;
  }

  .cuerpo-loc__barrios {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .cuerpo-loc__barrios li {
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--linea-clara);
    border-radius: 999px;
  }

  .cuerpo-loc__cobertura .prosa {
    margin-top: 1.5rem;
  }
</style>
