---
/**
 * Hub de zonas (spec §36): explica el criterio de cobertura (spec §27) y
 * enlaza solo las localidades ready. Lleva el mapa de Google bajo demanda.
 */
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import CallButton from '@components/CallButton.astro';
import ZonasMapa from '@components/ZonasMapa.astro';
import MapaCargaBajoDemanda from '@components/MapaCargaBajoDemanda.astro';
import CtaFinal from '@components/CtaFinal.astro';

const localidades = await getCollection('localidades', (l) => l.data.cerrajeroPropio);
---

<Layout
  titulo="Zonas de Servicio: Cerrajeros en Madrid y Alrededores | Openservi"
  descripcion="Las 16 zonas alrededor de Madrid en las que uno de nuestros cerrajeros trabaja en la propia zona. Servicio 24 horas. Llama al 912 918 462."
  ruta="/cerrajeros/"
>
  <Breadcrumbs
    items={[
      { nombre: 'Inicio', ruta: '/' },
      { nombre: 'Cerrajeros', ruta: '/cerrajeros/' },
    ]}
  />

  <section class="tramo zonas-hub">
    <div class="envoltura">
      <h1 class="titular zonas-hub__h1 metal">Zonas de servicio: cerrajeros en Madrid y alrededores</h1>
      <div class="zonas-hub__criterio prosa">
        <p>
          Trabajamos en Madrid y en estas 16 zonas. <strong>En cada una trabaja uno de nuestros cerrajeros</strong>: por eso
          aparecen aquí y no otras. Si una zona no está en el mapa, llámanos igualmente y te decimos si podemos atenderte.
        </p>
      </div>
      <div class="zonas-hub__accion"><CallButton cta="hub-zonas" sub="24 horas" /></div>

      <div class="zonas-hub__rejilla">
        <ZonasMapa localidades={localidades} />
        <MapaCargaBajoDemanda />
      </div>
    </div>
  </section>

  <CtaFinal cta="final-hub-zonas" />
</Layout>

<style>
  .zonas-hub {
    padding-top: clamp(1.5rem, 4vw, 3rem);
    background:
      radial-gradient(40rem 24rem at 85% 10%, rgb(212 175 55 / 0.1), transparent 62%),
      var(--obsidiana-profunda);
  }

  .zonas-hub__h1 {
    max-width: 56rem;
    font-size: clamp(1.6rem, 1.05rem + 2.6vw, 3.1rem);
  }

  .zonas-hub__criterio {
    margin-top: 1.5rem;
    color: var(--plata);
  }

  .zonas-hub__accion {
    margin-top: 1.75rem;
  }

  .zonas-hub__rejilla {
    display: grid;
    gap: 2.5rem;
    margin-top: 3rem;
    align-items: start;
  }

  @media (min-width: 1000px) {
    .zonas-hub__rejilla {
      grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.6fr);
    }
  }
</style>
