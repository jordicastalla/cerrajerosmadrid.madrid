---
import Layout from '@layouts/Layout.astro';
import CallButton from '@components/CallButton.astro';
import Emblema from '@components/marca/Emblema.astro';
import { site } from '@data/site';
---

<Layout titulo={`Página no encontrada | ${site.nombre}`} descripcion="La página que buscas no existe o se ha movido." ruta="/404/" noindex>
  <section class="error envoltura">
    <Emblema tam={200} clase="error__emblema" />
    <div>
      <p class="rotulo">Error 404</p>
      <h1 class="titular error__titulo"><span class="metal">Esta puerta</span> <span class="dorado">no existe</span></h1>
      <p class="error__texto">
        La página que buscas no está disponible o ha cambiado de sitio. Si necesitas un cerrajero, llámanos directamente.
      </p>
      <div class="error__acciones">
        <CallButton cta="404" sub="24 horas" />
        <a href="/" class="enlace">Volver al inicio →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .error {
    display: grid;
    gap: 3rem;
    align-items: center;
    min-height: 70vh;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  @media (min-width: 860px) {
    .error {
      grid-template-columns: auto 1fr;
      gap: 4rem;
    }
  }

  :global(.error__emblema) {
    width: min(12rem, 40vw);
    height: auto;
  }

  .error__titulo {
    margin-top: 1.1rem;
  }

  .error__texto {
    margin-top: 1.25rem;
    max-width: 32rem;
    font-size: 1.125rem;
    color: var(--plata-2);
  }

  .error__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 2rem;
  }
</style>
