---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import LocalBusinessSchema from '@components/LocalBusinessSchema.astro';
import CallButton from '@components/CallButton.astro';
import EEATBadges from '@components/EEATBadges.astro';
import Triage from '@components/Triage.astro';
import ComoTrabajamos from '@components/ComoTrabajamos.astro';
import TrabajosReales from '@components/TrabajosReales.astro';
import ZonasMapa from '@components/ZonasMapa.astro';
import MapaCargaBajoDemanda from '@components/MapaCargaBajoDemanda.astro';
import Reviews from '@components/Reviews.astro';
import Faq from '@components/Faq.astro';
import CtaFinal from '@components/CtaFinal.astro';
import KeyCutDivider from '@components/KeyCutDivider.astro';
import Emblema from '@components/marca/Emblema.astro';
import Skyline from '@components/marca/Skyline.astro';
import { site, telHref } from '@data/site';
import emblema from '@/assets/marca/emblema.webp';

// Emblema de la portada: solo se descarga en pantallas anchas (en móvil no se muestra)
const emblemaPortada = await getImage({ src: emblema, width: 352, densities: [1, 2] });

const localidades = await getCollection('localidades', (l) => l.data.cerrajeroPropio);
const zonasReady = localidades.filter((l) => l.data.status === 'ready').map((l) => l.data.nombre);

const faqs = [
  // Pregunta y respuesta aportadas por el cliente (2026-10-06): el tiempo medio es dato de la empresa
  {
    p: '¿Cuánto tardan en llegar ante una urgencia?',
    r: 'Atendemos urgencias en Madrid en un tiempo medio de 20 a 30 minutos. Somos tu ángel de la guarda cuando no puedes entrar a tu hogar.',
  },
  {
    p: '¿Atendéis de noche, en fin de semana y en festivos?',
    r: 'Sí. El servicio funciona las 24 horas, todos los días, también de madrugada, en fin de semana y en festivos.',
  },
  {
    p: '¿Cuánto cuesta?',
    r: 'Depende del trabajo, de la puerta y de la cerradura. Por teléfono te explicamos cómo lo presupuestamos y, antes de empezar, te damos el presupuesto sin compromiso.',
  },
  {
    p: '¿Vais a romper la cerradura para abrir la puerta?',
    r: 'Si la puerta se ha cerrado de golpe sin echar la llave, normalmente no hace falta. Si estaba cerrada con llave o la cerradura está dañada, te explicamos antes las opciones.',
  },
  {
    p: '¿Me pediréis algún documento antes de abrir?',
    r: 'Sí. Antes de abrir una puerta te pedimos que acredites de forma razonable tu relación con la vivienda o el local.',
  },
  {
    p: '¿Dónde trabajáis?',
    r: 'En Madrid y en 16 zonas de alrededor. En cada una de esas zonas trabaja uno de nuestros cerrajeros.',
  },
  // Aportada por el cliente (2026-10-06)
  {
    p: '¿Atienden zonas cercanas si no aparecen en la lista de barrios?',
    r: 'Sí, aunque no esté tu zona explícitamente listada, trabajamos en todas las de alrededor con total rapidez.',
  },
  ...(site.garantia.activa
    ? [
        {
          p: '¿Dais garantía?',
          r: 'Sí. Cada trabajo incluye garantía por escrito: figura en el parte o en la factura del servicio, con sus condiciones.',
        },
      ]
    : []),
];
---

<Layout
  titulo="Cerrajeros Madrid 24 Horas | Apertura de Puertas | OpenServi"
  descripcion="Cerrajeros en Madrid 24 horas: apertura de puertas, cambio de cerraduras y cerrojos de seguridad. Cerrajeros propios en 16 zonas. Llama al 912 918 462."
  ruta="/"
>
  <LocalBusinessSchema zonasReady={zonasReady} />

  <!-- Hero: empieza por el problema (spec §6) -->
  <section class="portada">
    <div class="envoltura portada__rejilla">
      <div class="portada__texto">
        <h1 class="titular portada__h1">
          <span class="metal">Cerrajeros en Madrid</span>
          <span class="dorado">24 horas</span>
        </h1>
        <p class="portada__sub">¿Te has quedado fuera de casa? Llámanos.</p>

        <div class="portada__acciones">
          <CallButton cta="hero" sub="Servicio 24 horas" />
          <a href={telHref} class="portada__tel" data-cta="hero-texto">{site.telefono}</a>
        </div>

        <EEATBadges clase="portada__insignias" />
      </div>

      <div class="portada__visual" aria-hidden="true">
        <picture>
          <source media="(min-width: 980px)" srcset={emblemaPortada.srcSet.attribute} type="image/webp" />
          <img
            src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
            alt=""
            width="352"
            height="352"
            class="portada__emblema"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
    </div>
    <Skyline clase="portada__skyline" />
  </section>

  <Triage />

  <!-- Servicios: lectura en blanco -->
  <div class="claro servicios">
    <section class="tramo envoltura servicio" aria-labelledby="cerrajeros-madrid">
      <p class="rotulo">OpenServi</p>
      <h2 class="seccion__titulo" id="cerrajeros-madrid">Cerrajeros en Madrid</h2>
      <div class="prosa servicio__prosa">
        <p>
          Somos cerrajeros en Madrid y atendemos las 24 horas: aperturas de puertas, cambios de cerradura y de bombín, e
          instalación de cerrojos de seguridad en viviendas, portales, trasteros, locales y oficinas.
        </p>
        <p>
          Además de la ciudad, trabajamos en <a href="#zonas">16 zonas de alrededor</a> en las que uno de nuestros
          cerrajeros trabaja en la propia zona.
        </p>
        <p>Antes de empezar cualquier trabajo te explicamos qué vamos a hacer y te damos el presupuesto, sin compromiso.</p>
      </div>
    </section>

    <KeyCutDivider />

    <section class="tramo envoltura servicio servicio--doble" id="apertura-de-puertas" aria-labelledby="apertura-titulo">
      <div>
        <p class="rotulo">Te has quedado fuera</p>
        <h2 class="seccion__titulo" id="apertura-titulo">Apertura de Puertas</h2>
        <div class="prosa servicio__prosa">
          <p>
            Si te has quedado fuera, llama al <a href={telHref} data-cta="apertura">{site.telefono}</a> y cuéntanos qué ha
            pasado: si las llaves están dentro o se han perdido, y si echaste la llave al salir.
          </p>
          <p>
            Cuando la puerta se ha cerrado de golpe sin echar la llave, normalmente se puede abrir sin romper la cerradura. Si
            estaba cerrada con llave, te explicamos antes las opciones y su presupuesto.
          </p>
          <p>Antes de abrir te pedimos que acredites de forma razonable tu relación con la vivienda o el local.</p>
        </div>
      </div>
      <div class="tarjeta servicio__ficha">
        <h3>Qué abrimos</h3>
        <ul>
          <li>Puertas de vivienda y de portal</li>
          <li>Puertas blindadas y acorazadas</li>
          <li>Trasteros, locales y oficinas</li>
        </ul>
        <CallButton cta="apertura-ficha" />
      </div>
    </section>

    <KeyCutDivider />

    <div class="envoltura servicios__par">
      <section class="tramo servicio" id="cambio-de-cerraduras" aria-labelledby="cambio-titulo">
        <p class="rotulo">Llaves perdidas o mudanza</p>
        <h2 class="seccion__titulo" id="cambio-titulo">Cambio de Cerraduras</h2>
        <p class="servicio__texto">
          Cambiamos la cerradura completa o solo el bombín cuando pierdes las llaves, te mudas, cambia el inquilino o la
          cerradura falla. Te explicamos qué conviene en tu puerta antes de tocar nada.
        </p>
        <a class="enlace" href="/servicios/cambio-de-cerraduras-madrid/">Cambio de cerraduras en Madrid →</a>
      </section>

      <section class="tramo servicio" id="instalacion-de-cerrojos" aria-labelledby="cerrojos-titulo">
        <p class="rotulo">Más seguridad</p>
        <h2 class="seccion__titulo" id="cerrojos-titulo">Instalación de Cerrojos de Seguridad</h2>
        <p class="servicio__texto">
          Un cerrojo de seguridad añade un segundo punto de cierre a la puerta. Te explicamos qué tipo encaja con tu puerta y
          te damos el presupuesto antes de instalarlo.
        </p>
        <a class="enlace" href="/servicios/instalacion-de-cerrojos-madrid/">Instalación de cerrojos de seguridad en Madrid →</a>
      </section>
    </div>

    <KeyCutDivider />

    <!-- Texto del cliente (v2.2) -->
    <section class="tramo envoltura" id="quienes-somos" aria-labelledby="quienes-titulo">
      <div class="quienes-somos">
        <Emblema
          tam={240}
          clase="quienes-somos__emblema"
          titulo="Emblema de CerrajerosMadrid.Madrid: la Victoria Alada sosteniendo una llave dorada"
        />
        <div>
          <p class="rotulo">Nuestro emblema</p>
          <h2 class="seccion__titulo" id="quienes-titulo">Quiénes Somos</h2>
          <div class="prosa quienes-somos__prosa">
            <p>
              En <strong>CerrajerosMadrid.Madrid</strong> combinamos rapidez, profesionalidad y confianza al servicio de los
              madrileños. Nuestro emblema rinde homenaje a uno de los monumentos más populares e icónicos de Madrid:
              <strong>La Victoria Alada</strong>, representada sosteniendo una llave dorada.
            </p>
            <p>
              Para nosotros, la Victoria Alada representa la protección y la tranquilidad de recuperar el acceso a tu espacio
              seguro. Nos gusta ser ese <em>ángel de la guarda</em> que está ahí cuando no puedes entrar a tu hogar o negocio,
              respondiendo con eficacia en el momento que más lo necesitas.
            </p>
          </div>
          <a class="enlace quienes-somos__mas" href="/quienes-somos/">Conoce nuestra historia y el logotipo →</a>
        </div>
      </div>
    </section>
  </div>

  <section class="urgente tramo tramo--profundo" id="cerrajero-urgente-24-horas" aria-labelledby="urgente-titulo">
    <div class="envoltura urgente__rejilla">
      <div>
        <p class="rotulo">De día y de noche</p>
        <h2 class="seccion__titulo" id="urgente-titulo">Cerrajero Urgente 24 Horas</h2>
        <p class="seccion__entrada">
          Atendemos las 24 horas, todos los días: también de madrugada, en fin de semana y en festivos. Llámanos y cuéntanos
          qué ha pasado; si no sabes por dónde empezar, <a class="enlace" href="#que-te-ha-pasado">mira qué te ha pasado</a>.
        </p>
      </div>
      <CallButton cta="urgente" sub="24 horas, todos los días" />
    </div>
  </section>

  <ComoTrabajamos />

  <TrabajosReales />

  <section class="zonas tramo" id="zonas" aria-labelledby="zonas-titulo">
    <div class="envoltura">
      <p class="rotulo">Cerrajeros propios en 16 zonas</p>
      <h2 class="seccion__titulo" id="zonas-titulo">Zonas donde trabajamos</h2>
      <!-- Texto del cliente (v2.2) -->
      <p class="seccion__entrada zonas__entrada">
        Atendemos en todo Madrid. <strong
          >Aunque no esté tu zona en la lista, trabajamos en todas las de alrededor. Somos rápidos y tenemos un buen equipo
          listo para ayudarte.</strong
        >
      </p>
      <div class="zonas__rejilla">
        <ZonasMapa localidades={localidades} />
        <MapaCargaBajoDemanda />
      </div>
    </div>
  </section>

  <Reviews />

  <Faq faqs={faqs} />

  <CtaFinal />
</Layout>

<style>
  /* --- Portada ------------------------------------------------------ */
  .portada {
    position: relative;
    overflow: hidden;
    padding-top: clamp(2rem, 6vw, 5rem);
    /* Hueco para la calle del perfil de Madrid, que sube por detrás del texto */
    padding-bottom: clamp(7rem, 17vw, 13rem);
    background:
      radial-gradient(42rem 28rem at 78% 38%, rgb(212 175 55 / 0.16), transparent 62%),
      radial-gradient(30rem 20rem at 8% 0%, rgb(148 163 184 / 0.08), transparent 70%),
      var(--obsidiana-profunda);
  }

  .portada__rejilla {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 980px) {
    .portada__rejilla {
      grid-template-columns: minmax(0, 1.25fr) minmax(16rem, 0.75fr);
    }
  }

  .portada__h1 span {
    display: inline;
  }

  .portada__sub {
    margin-top: 1.25rem;
    font-size: clamp(1.2rem, 1.05rem + 0.7vw, 1.6rem);
    font-weight: 600;
    color: var(--blanco);
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.75rem;
  }

  .portada__tel {
    font-family: var(--f-marca);
    font-size: clamp(1.15rem, 1rem + 0.8vw, 1.5rem);
    letter-spacing: 0.04em;
    color: var(--oro);
    text-decoration: none;
    border-bottom: 1px solid var(--linea-oro);
  }

  .portada__tel:hover {
    border-color: var(--oro);
  }

  :global(.portada__insignias) {
    margin-top: 2rem !important;
  }

  .portada__visual {
    display: none;
  }

  @media (min-width: 980px) {
    .portada__visual {
      display: grid;
      place-items: center;
    }
  }

  .portada__emblema {
    width: min(100%, 22rem);
    height: auto;
    filter: drop-shadow(0 0 48px rgb(212 175 55 / 0.28));
  }

  .portada :global(.portada__skyline) {
    --skyline-opacidad: 0.34;
  }

  /* --- Servicios (blanco) -------------------------------------------- */
  .servicio__prosa {
    margin-top: 1.25rem;
  }

  .servicio--doble {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .servicio--doble {
      grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.6fr);
      gap: 4rem;
    }
  }

  .servicio__ficha h3 {
    font-size: 1.2rem;
  }

  .servicio__ficha ul {
    margin: 1rem 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .servicio__ficha li {
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--linea-clara);
    color: var(--obsidiana);
  }

  .servicios__par {
    display: grid;
  }

  @media (min-width: 900px) {
    .servicios__par {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .servicios__par .tramo {
    padding-inline: 0;
  }

  .servicio__texto {
    margin: 1.1rem 0 1.4rem;
    max-width: 34rem;
    color: var(--pizarra);
  }

  /* --- Urgente ------------------------------------------------------- */
  .urgente {
    background:
      radial-gradient(36rem 20rem at 85% 50%, rgb(245 158 11 / 0.1), transparent 65%),
      var(--obsidiana-profunda);
  }

  .urgente__rejilla {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .urgente__rejilla {
      grid-template-columns: 1fr auto;
      gap: 3rem;
    }
  }

  /* --- Zonas --------------------------------------------------------- */
  .zonas__rejilla {
    display: grid;
    gap: 2.5rem;
    margin-top: 2.5rem;
    align-items: start;
  }

  @media (min-width: 1000px) {
    .zonas__rejilla {
      grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.6fr);
    }
  }

  .zonas__entrada strong {
    color: var(--plata);
  }

  /* --- Quiénes somos (tarjeta con el formato que pide el cliente) ----- */
  .quienes-somos {
    display: grid;
    gap: 2rem;
    align-items: center;
    margin: 25px 0;
    padding: 30px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
  }

  @media (min-width: 860px) {
    .quienes-somos {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 3.5rem;
      padding: 30px 3rem 30px 30px;
    }
  }

  :global(.quienes-somos__emblema) {
    justify-self: center;
    width: clamp(10rem, 30vw, 15rem);
    height: auto;
  }

  .quienes-somos__prosa {
    margin-top: 1.25rem;
  }

  .quienes-somos__mas {
    margin-top: 1.5rem;
  }
</style>
