---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import LocalBusinessSchema from '@components/LocalBusinessSchema.astro';
import CallButton from '@components/CallButton.astro';
import EEATBadges from '@components/EEATBadges.astro';
import Triage from '@components/Triage.astro';
import ComoTrabajamos from '@components/ComoTrabajamos.astro';
import TrabajosReales from '@components/TrabajosReales.astro';
import ZonasMapa from '@components/ZonasMapa.astro';
import MapaCargaBajoDemanda from '@components/MapaCargaBajoDemanda.astro';
import Reviews from '@components/Reviews.astro';
import Faq from '@components/Faq.astro';
import ImagenHome from '@components/ImagenHome.astro';
import Icono from '@components/ui/Icono.astro';
import KeyCutDivider from '@components/KeyCutDivider.astro';
import Skyline from '@components/marca/Skyline.astro';
import { site, telHref } from '@data/site';
import emblema from '@/assets/marca/emblema.webp';

// Emblema de la portada: solo se descarga en pantallas anchas (en móvil no se muestra)
const emblemaPortada = await getImage({ src: emblema, width: 352, densities: [1, 2] });

const localidades = await getCollection('localidades', (l) => l.data.cerrajeroPropio);

// «¿Por qué elegir el concepto OpenServi?» y «¿Buscas un cerrajero cerca?»: textos del cliente (v2.5)
const porque = [
  {
    icono: 'telefono',
    titulo: 'Sin intermediarios externos',
    texto:
      'Hablas directamente con nuestro equipo de coordinación, que localiza y envía al cerrajero en Madrid más cercano a tu ubicación en cuestión de minutos, sin plataformas de terceros que encarecen el servicio.',
  },
  {
    icono: 'mapa',
    titulo: 'Hasta 16 técnicos en red por toda la Comunidad',
    texto:
      'Reducimos al mínimo el tiempo de espera al contar con unidades móviles distribuidas por los principales distritos y municipios colindantes.',
  },
  {
    icono: 'escudo',
    titulo: 'Cerrajería transparente y honesta',
    texto: 'Te explicamos el problema en lenguaje sencillo, sin términos ambiguos ni costes sorpresa al finalizar el trabajo.',
  },
  {
    icono: 'bombin',
    titulo: 'Primeras marcas y formación continua',
    texto:
      'Trabajamos únicamente con materiales de alta calidad y componentes de los fabricantes líderes en seguridad (Mauer, Tesa, Kaba, Fichet, Cisa, etc.). Además, nuestros cerrajeros se forman de forma constante para dominar las últimas técnicas de apertura no destructiva y los nuevos sistemas antibumping y antiganzúa del mercado.',
  },
  {
    icono: 'llave',
    titulo: 'Talleres móviles equipados',
    texto:
      'Cada vehículo funciona como un taller completo con herramientas de precisión y recambios de las principales marcas de seguridad para solucionar la urgencia en una sola visita.',
  },
] as const;

const pasosCerca = [
  {
    icono: 'telefono',
    titulo: 'Atención inmediata',
    texto: 'Nos explicas brevemente lo que ocurre y te damos una estimación del servicio.',
  },
  { icono: 'factura', titulo: 'Sin sorpresas', texto: 'Sabrás las condiciones claras antes de que salga el vehículo.' },
  {
    icono: 'rayo',
    titulo: 'Llegada en tiempo récord',
    texto: 'Asignamos al técnico que se encuentre más próximo a tu calle para abrir tu puerta sin esperas innecesarias.',
  },
] as const;
const zonasReady = localidades.filter((l) => l.data.status === 'ready').map((l) => l.data.nombre);

const faqs = [
  // Pregunta y respuesta aportadas por el cliente (2026-10-06): el tiempo medio es dato de la empresa
  {
    p: '¿Cuánto tardan en llegar ante una urgencia?',
    r: 'Atendemos urgencias en Madrid en un tiempo medio de 20 a 30 minutos. Somos tu ángel de la guarda cuando no puedes entrar a tu hogar.',
  },
  {
    p: '¿Atendéis de noche, en fin de semana y en festivos?',
    r: 'Sí. El servicio funciona las 24 horas, todos los días, también de madrugada, en fin de semana y en festivos.',
  },
  {
    p: '¿Cuánto cuesta?',
    r: 'Depende del trabajo, de la puerta y de la cerradura. Por teléfono te informamos de la tarifa estimada antes de desplazarnos y, antes de empezar, te damos el presupuesto sin compromiso.',
  },
  {
    p: '¿Vais a romper la cerradura para abrir la puerta?',
    r: 'Si la puerta se ha cerrado de golpe sin echar la llave, normalmente no hace falta. Si estaba cerrada con llave o la cerradura está dañada, te explicamos antes las opciones.',
  },
  {
    p: '¿Me pediréis algún documento antes de abrir?',
    r: 'Sí. Antes de abrir una puerta te pedimos que acredites de forma razonable tu relación con la vivienda o el local.',
  },
  {
    p: '¿Dónde trabajáis?',
    r: 'En Madrid y en 16 zonas de alrededor. En cada una de esas zonas trabaja uno de nuestros cerrajeros.',
  },
  // Aportada por el cliente (2026-10-06)
  {
    p: '¿Atienden zonas cercanas si no aparecen en la lista de barrios?',
    r: 'Sí, aunque no esté tu zona explícitamente listada, trabajamos en todas las de alrededor con total rapidez.',
  },
  ...(site.garantia.activa
    ? [
        {
          p: '¿Dais garantía?',
          r: 'Sí. Cada trabajo incluye garantía por escrito: figura en el parte o en la factura del servicio, con sus condiciones.',
        },
      ]
    : []),
];
---

<Layout
  titulo="Cerrajeros Madrid 24 Horas | Apertura de Puertas | OpenServi"
  descripcion="Cerrajeros en Madrid 24 horas: apertura de puertas, cambio de cerraduras y cerrojos de seguridad. Cerrajeros propios en 16 zonas. Llama al 912 918 462."
  ruta="/"
>
  <LocalBusinessSchema zonasReady={zonasReady} />

  <!-- Hero: empieza por el problema (spec §6) -->
  <section class="portada">
    <div class="envoltura portada__rejilla">
      <div class="portada__texto">
        <h1 class="titular portada__h1">
          <span class="metal">Cerrajeros en Madrid</span>
          <span class="dorado">24 horas</span>
        </h1>
        <p class="portada__sub">¿Te has quedado fuera de casa? Llámanos.</p>

        <div class="portada__acciones">
          <CallButton cta="hero" sub="Servicio 24 horas" />
          <a href={telHref} class="portada__tel" data-cta="hero-texto">{site.telefono}</a>
        </div>

        <EEATBadges clase="portada__insignias" />
      </div>

      <div class="portada__visual" aria-hidden="true">
        <picture>
          <source media="(min-width: 980px)" srcset={emblemaPortada.srcSet.attribute} type="image/webp" />
          <img
            src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
            alt=""
            width="352"
            height="352"
            class="portada__emblema"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
    </div>
    <Skyline clase="portada__skyline" />
  </section>

  <Triage />

  <!-- Servicios: lectura en blanco -->
  <div class="claro servicios">
    <!-- Texto del cliente (v2.5) -->
    <section class="tramo envoltura servicio con-imagen" aria-labelledby="cerrajeros-madrid">
      <div>
        <p class="rotulo">OpenServi</p>
        <h2 class="seccion__titulo" id="cerrajeros-madrid">Cerrajeros en Madrid</h2>
        <div class="prosa servicio__prosa">
          <p>
            Cerrajeros Madrid OpenServi somos la unión de un equipo de cerrajeros que trabaja por todo Madrid y provincia,
            repartidos en diferentes barrios y localidades. Aunque nacimos como unión de cerrajeros en 2017, llevamos toda una
            vida trabajando en el sector de la cerrajería y la seguridad en Madrid de forma individual.
          </p>
          <p>
            En OpenServi hemos cambiado la forma de entender la cerrajería de urgencia. No somos una macroagencia ni una
            plataforma con comisionistas. Somos una unión de hasta 16 cerrajeros profesionales repartidos por toda la
            Comunidad de Madrid.
          </p>
          <p>
            Ofrecemos un servicio abierto, transparente y directo: sin intermediarios ni comisiones. De todas formas, si tu
            municipio o barrio no aparece en esta web y estás cerca, nos desplazamos a la mayor brevedad. Realizamos apertura
            de puertas las 24 horas y los 365 días del año (y sí, si es bisiesto, también el 29 de febrero).
          </p>
          <p>
            Si buscas un cerrajero en Madrid porque te has dejado las llaves dentro, la cerradura se ha atascado o necesitas
            un cambio de bombín urgente, no hace falta que te leas todo este texto:
            <a href={telHref} data-cta="presentacion">llámanos directamente al teléfono de contacto</a>. Te atenderá nuestro
            equipo, que te pondrá en contacto con un técnico de tu zona, sin rodeos, con amabilidad y dándote la solución
            adecuada antes de salir hacia tu dirección.
          </p>
        </div>
      </div>
      <ImagenHome n={1} />
    </section>

    <KeyCutDivider />

    <section class="tramo envoltura servicio servicio--doble" id="apertura-de-puertas" aria-labelledby="apertura-titulo">
      <div>
        <p class="rotulo">Te has quedado fuera</p>
        <h2 class="seccion__titulo" id="apertura-titulo">Apertura de Puertas</h2>
        <div class="prosa servicio__prosa">
          <p>
            Si te has quedado fuera, llama al <a href={telHref} data-cta="apertura">{site.telefono}</a> y cuéntanos qué ha
            pasado: si las llaves están dentro o se han perdido, y si echaste la llave al salir.
          </p>
          <p>
            Cuando la puerta se ha cerrado de golpe sin echar la llave, normalmente se puede abrir sin romper la cerradura. Si
            estaba cerrada con llave, te explicamos antes las opciones y su presupuesto.
          </p>
          <p>Antes de abrir te pedimos que acredites de forma razonable tu relación con la vivienda o el local.</p>
        </div>
      </div>
      <div class="tarjeta servicio__ficha">
        <h3>Qué abrimos</h3>
        <ul>
          <li>Puertas de vivienda y de portal</li>
          <li>Puertas blindadas y acorazadas</li>
          <li>Trasteros, locales y oficinas</li>
        </ul>
        <CallButton cta="apertura-ficha" />
      </div>
    </section>

    <KeyCutDivider />

    <div class="envoltura servicios__par">
      <section class="tramo servicio" id="cambio-de-cerraduras" aria-labelledby="cambio-titulo">
        <p class="rotulo">Llaves perdidas o mudanza</p>
        <h2 class="seccion__titulo" id="cambio-titulo">Cambio de Cerraduras</h2>
        <p class="servicio__texto">
          Cambiamos la cerradura completa o solo el bombín cuando pierdes las llaves, te mudas, cambia el inquilino o la
          cerradura falla. Te explicamos qué conviene en tu puerta antes de tocar nada.
        </p>
        <a class="enlace" href="/servicios/cambio-de-cerraduras-madrid/">Cambio de cerraduras en Madrid →</a>
      </section>

      <section class="tramo servicio" id="instalacion-de-cerrojos" aria-labelledby="cerrojos-titulo">
        <p class="rotulo">Más seguridad</p>
        <h2 class="seccion__titulo" id="cerrojos-titulo">Instalación de Cerrojos de Seguridad</h2>
        <p class="servicio__texto">
          Un cerrojo de seguridad añade un segundo punto de cierre a la puerta. Te explicamos qué tipo encaja con tu puerta y
          te damos el presupuesto antes de instalarlo.
        </p>
        <a class="enlace" href="/servicios/instalacion-de-cerrojos-madrid/">Instalación de cerrojos de seguridad en Madrid →</a>
      </section>
    </div>
  </div>

  <!-- Texto del cliente (v2.5) -->
  <section class="urgente tramo tramo--profundo" id="cerrajero-urgente-24-horas" aria-labelledby="urgente-titulo">
    <div class="envoltura urgente__rejilla">
      <ImagenHome n={2} clase="urgente__imagen" />
      <div>
        <p class="rotulo">De día y de noche</p>
        <h2 class="seccion__titulo" id="urgente-titulo">Cerrajería 24 horas y urgencias para imprevistos reales en Madrid</h2>
        <div class="prosa urgente__prosa">
          <p>
            Sabemos que los problemas con las cerraduras nunca avisan y las urgencias de cerrajería aparecen en el momento más
            inoportuno: salir con prisas por la mañana y dejarte las llaves puestas por dentro, perderlas de madrugada tras la
            celebración del último derbi o encontrarte con la llave partida justo al volver de un concierto en el Movistar
            Arena.
          </p>
          <p>
            En esos momentos de agobio parece que aquí se va a montar un 2 de mayo, y más aún si la emergencia te pilla en
            pleno 2 de Mayo, Día de la Comunidad de Madrid. Pero no hace falta montar ninguna batalla ni perder los nervios:
            como cerrajeros de urgencia 24 horas en Madrid, nos llamas, acudimos de inmediato y asunto resuelto.
          </p>
          <p>
            Al estar integrados por un equipo de hasta 16 cerrajeros en Madrid, garantizamos una atención rápida y sin esperas
            las 24 horas del día, los 365 días del año, sea festivo o laborable.
          </p>
        </div>
        <div class="urgente__accion"><CallButton cta="urgente" sub="24 horas, todos los días" /></div>
      </div>
    </div>
  </section>

  <!-- Texto del cliente (v2.5) -->
  <section class="porque tramo" id="por-que-openservi" aria-labelledby="porque-titulo">
    <div class="envoltura">
      <p class="rotulo">Sin rollos</p>
      <h2 class="seccion__titulo" id="porque-titulo">¿Por qué elegir el concepto OpenServi?</h2>
      <p class="seccion__entrada porque__entrada">
        No te vamos a soltar el típico rollo de que somos «los mejores» o «el número 1 de Madrid», como leerás en otras
        páginas de dudosa confianza. Preferimos trabajar bien, darte un trato justo y que lo compruebes tú mismo cuando nos
        llames.
      </p>
      <ul class="porque__lista">
        {
          porque.map((v) => (
            <li class="tarjeta porque__item">
              <span class="porque__icono" aria-hidden="true">
                <Icono nombre={v.icono} tam={22} />
              </span>
              <h3 class="porque__titulo">{v.titulo}</h3>
              <p class="porque__texto">{v.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Texto del cliente (v2.5) -->
  <div class="claro">
    <section class="tramo envoltura economico" id="cerrajero-economico" aria-labelledby="economico-titulo">
      <p class="rotulo">Precio claro</p>
      <h2 class="seccion__titulo" id="economico-titulo">¿Buscas un cerrajero económico en Madrid?</h2>
      <div class="prosa economico__prosa">
        <p>
          Si estás buscando cerrajeros baratos en Madrid y de calidad contrastada,
          <a href={telHref} data-cta="economico">llámanos y compruébalo</a>.
        </p>
        <p>
          Sabemos que en el sector de la cerrajería de urgencia abundan las sorpresas desagradables en la factura final. Los
          precios de los servicios son muy variados y dependen mucho del trabajo a realizar (no es lo mismo abrir una puerta
          que se ha cerrado de un portazo que cambiar un bombín de alta seguridad a medianoche), pero en OpenServi siempre
          encontrarás un precio justo, claro y sin letra pequeña.
        </p>
      </div>
      <p class="economico__destacado">
        <Icono nombre="factura" tam={22} />
        <span>
          Te informamos de la tarifa estimada por teléfono antes de desplazarnos para que sepas lo que vas a pagar desde el
          primer minuto. Sin trucos ni sobrecostes ocultos.
        </span>
      </p>
    </section>
  </div>

  <ComoTrabajamos />

  <TrabajosReales />

  <section class="zonas tramo" id="zonas" aria-labelledby="zonas-titulo">
    <div class="envoltura">
      <p class="rotulo">Cerrajeros propios en 16 zonas</p>
      <h2 class="seccion__titulo" id="zonas-titulo">Zonas donde trabajamos</h2>
      <!-- Texto del cliente (v2.2) -->
      <p class="seccion__entrada zonas__entrada">
        Atendemos en todo Madrid. <strong
          >Aunque no esté tu zona en la lista, trabajamos en todas las de alrededor. Somos rápidos y tenemos un buen equipo
          listo para ayudarte.</strong
        >
      </p>
      <div class="zonas__rejilla">
        <ZonasMapa localidades={localidades} />
        <MapaCargaBajoDemanda />
      </div>
    </div>
  </section>

  <Reviews />

  <Faq faqs={faqs} />

  <!-- Texto del cliente (v2.5) -->
  <section class="cerca tramo tramo--profundo" id="cerrajero-cerca" aria-labelledby="cerca-titulo">
    <Skyline clase="cerca__skyline" />
    <div class="envoltura cerca__contenido">
      <p class="rotulo">Estás a una llamada</p>
      <h2 class="seccion__titulo" id="cerca-titulo">¿Buscas un cerrajero cerca en Madrid? Llámanos ahora</h2>
      <div class="prosa cerca__prosa">
        <p>
          Si has llegado hasta aquí leyendo y sigues parado frente a tu puerta sin saber qué hacer, no lo pienses más. Estás a
          una sola llamada de resolver la incidencia de forma rápida, limpia y sin sustos en la factura.
        </p>
        <p>
          Al contar con una red de profesionales distribuidos por toda la Comunidad, siempre tenemos a un cerrajero cerca de ti
          listo para ponerse en marcha en cualquier distrito o municipio de Madrid.
        </p>
      </div>
      <ol class="cerca__pasos">
        {
          pasosCerca.map((p) => (
            <li class="tarjeta cerca__paso">
              <span class="cerca__icono" aria-hidden="true">
                <Icono nombre={p.icono} tam={22} />
              </span>
              <h3 class="cerca__titulo">{p.titulo}</h3>
              <p>{p.texto}</p>
            </li>
          ))
        }
      </ol>
      <p class="cerca__cierre">
        <a href={telHref} data-cta="cerca-texto">Llama ahora al teléfono de contacto</a>, cuéntanos tu caso y tendrás a un
        cerrajero cerca de ti solucionando el problema en cuestión de minutos.
      </p>
      <div class="cerca__accion">
        <CallButton cta="cerca" sub="24 horas, todos los días" />
        <a href={telHref} class="cerca__numero" data-cta="cerca-numero">{site.telefono}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* --- Portada ------------------------------------------------------ */
  .portada {
    position: relative;
    overflow: hidden;
    padding-top: clamp(2rem, 6vw, 5rem);
    /* Hueco para la calle del perfil de Madrid, que sube por detrás del texto */
    padding-bottom: clamp(7rem, 17vw, 13rem);
    background:
      radial-gradient(42rem 28rem at 78% 38%, rgb(212 175 55 / 0.16), transparent 62%),
      radial-gradient(30rem 20rem at 8% 0%, rgb(148 163 184 / 0.08), transparent 70%),
      var(--obsidiana-profunda);
  }

  .portada__rejilla {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 980px) {
    .portada__rejilla {
      grid-template-columns: minmax(0, 1.25fr) minmax(16rem, 0.75fr);
    }
  }

  .portada__h1 span {
    display: inline;
  }

  .portada__sub {
    margin-top: 1.25rem;
    font-size: clamp(1.2rem, 1.05rem + 0.7vw, 1.6rem);
    font-weight: 600;
    color: var(--blanco);
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.75rem;
  }

  .portada__tel {
    font-family: var(--f-marca);
    font-size: clamp(1.15rem, 1rem + 0.8vw, 1.5rem);
    letter-spacing: 0.04em;
    color: var(--oro);
    text-decoration: none;
    border-bottom: 1px solid var(--linea-oro);
  }

  .portada__tel:hover {
    border-color: var(--oro);
  }

  :global(.portada__insignias) {
    margin-top: 2rem !important;
  }

  .portada__visual {
    display: none;
  }

  @media (min-width: 980px) {
    .portada__visual {
      display: grid;
      place-items: center;
    }
  }

  .portada__emblema {
    width: min(100%, 22rem);
    height: auto;
    filter: drop-shadow(0 0 48px rgb(212 175 55 / 0.28));
  }

  .portada :global(.portada__skyline) {
    --skyline-opacidad: 0.34;
  }

  /* --- Servicios (blanco) -------------------------------------------- */
  .servicio__prosa {
    margin-top: 1.25rem;
  }

  .servicio--doble {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .servicio--doble {
      grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.6fr);
      gap: 4rem;
    }
  }

  .servicio__ficha h3 {
    font-size: 1.2rem;
  }

  .servicio__ficha ul {
    margin: 1rem 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .servicio__ficha li {
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--linea-clara);
    color: var(--obsidiana);
  }

  .servicios__par {
    display: grid;
  }

  @media (min-width: 900px) {
    .servicios__par {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .servicios__par .tramo {
    padding-inline: 0;
  }

  .servicio__texto {
    margin: 1.1rem 0 1.4rem;
    max-width: 34rem;
    color: var(--pizarra);
  }

  /* --- Urgente ------------------------------------------------------- */
  .urgente {
    background:
      radial-gradient(36rem 20rem at 85% 50%, rgb(245 158 11 / 0.1), transparent 65%),
      var(--obsidiana-profunda);
  }

  .urgente__rejilla {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .urgente__rejilla {
      grid-template-columns: minmax(16rem, 0.85fr) minmax(0, 1.15fr);
      gap: 4rem;
    }
  }

  /* Título largo del cliente: algo más pequeño que el resto de H2 para no ocupar cuatro líneas */
  .urgente .seccion__titulo {
    font-size: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);
  }

  .urgente__prosa {
    margin-top: 1.25rem;
    color: var(--plata);
  }

  .urgente__accion {
    margin-top: 2rem;
  }

  /* En móvil, la foto va después del texto */
  @media (max-width: 959px) {
    :global(.urgente__imagen) {
      order: 1;
    }
  }

  /* --- Presentación con foto ----------------------------------------- */
  .con-imagen {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

