---
import Layout from '@layouts/Layout.astro';
import Migas from '@components/ui/Migas.astro';
import Figura from '@components/ui/Figura.astro';
import Dentado from '@components/ui/Dentado.astro';
import BotonLlamar from '@components/ui/BotonLlamar.astro';
import CtaFinal from '@components/CtaFinal.astro';
import { empresa } from '@data/empresa';
import { migas as migasSchema } from '@lib/schema';

const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: 'Quiénes somos', ruta: '/quienes-somos/' },
];

const valores = [
  { t: 'Honestidad al presupuestar', d: 'La esencia de los inicios, intacta: el precio se explica antes de empezar.' },
  { t: 'Trato directo, de tú a tú', d: 'Hablas con quien va a resolver tu caso.' },
  { t: 'Sin intermediarios', d: 'Ni centrales telefónicas impersonales de por medio.' },
];
---

<Layout
  titulo="Quiénes Somos | La Historia de Nuestro Equipo en Chamartín"
  descripcion="Conoce la historia de nuestro equipo en Chamartín. Más de 15 años de experiencia ofreciendo un servicio cercano y honesto. Llama al 919 933 193."
  ruta="/quienes-somos/"
  schemasExtra={[migasSchema(migas)]}
>
  <Migas items={migas} />

  <section class="historia envoltura">
    <p class="rotulo">Quiénes somos</p>
    <h1 class="historia__titulo">Detrás de la cerradura: <em>la historia de nuestro equipo</em></h1>

    <div class="historia__rejilla">
      <blockquote class="historia__cita">
        <p>La cerrajería no es un oficio que se improvise de la noche a la mañana.</p>
      </blockquote>

      <div class="prosa">
        <p class="capitular">
          La cerrajería no es un oficio que se improvise de la noche a la mañana; se aprende a base
          de años de taller, tacto y mucha paciencia. Cuando el fundador de nuestro equipo se
          trasladó a Madrid hace más de 15 años, no empezaba de cero en la profesión: ya acumulaba
          un largo recorrido como cerrajero en su país de origen. Establecerse en un nuevo entorno no
          fue fácil, pero su maestría con los mecanismos más complejos y su compromiso por hacer las
          cosas bien le abrieron rápidamente las puertas entre los vecinos de Chamartín.
        </p>
        <p>
          Con el volumen de trabajo en aumento y las exigencias del barrio evolucionando, el equipo
          fue creciendo de forma natural. Se sumaron nuevos especialistas con la misma filosofía de
          trabajo, aportando soluciones técnicas actualizadas y la energía necesaria para consolidar
          un grupo humano preparado para responder ante cualquier necesidad de seguridad
          residencial y comercial.
        </p>
      </div>
    </div>
  </section>

  <Dentado arriba="var(--papel)" abajo="var(--tinta)" />
  <section class="oscuro equipo">
    <div class="envoltura equipo__rejilla">
      <div class="equipo__cifra">
        <p class="equipo__numero">15<span>+</span></p>
        <p class="equipo__leyenda">años desde que nuestro fundador se estableció en Madrid</p>
        <img
          src="/cerrajeros-chamartin.logo.webp"
          width="366"
          height="157"
          alt={`Logotipo de ${empresa.nombre}`}
          loading="lazy"
          decoding="async"
          class="equipo__logo"
        />
      </div>

      <div>
        <div class="prosa">
          <p class="capitular">
            Hoy somos una plantilla consolidada que mantiene intacta la esencia de los inicios:
            <strong>honestidad a la hora de presupuestar</strong>, <strong>trato directo de tú a tú</strong>
            y la tranquilidad de saber que <strong>no hay intermediarios ni centrales telefónicas
            impersonales</strong> de por medio. Conocemos el barrio, su gente y sus accesos mejor que
            nadie.
          </p>
        </div>

        <ul class="tablero equipo__valores">
          {
            valores.map((v) => (
              <li class="etiqueta">
                <h2>{v.t}</h2>
                <p>{v.d}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
  <Dentado arriba="var(--tinta)" abajo="var(--papel)" cortes={[4, 1, 5, 3, 6, 2, 7, 3, 5, 1, 4, 6, 2, 5, 3, 7, 1, 4, 6, 2, 5, 3]} />

  <section class="tramo envoltura cierre">
    <Figura
      src="/cambio-cerradura-chamartin.webp"
      alt="Placa de una cerradura de seguridad antigua en una puerta de madera"
      num="01"
      pie="Años de taller, tacto y mucha paciencia."
    />
    <div class="cierre__texto">
      <p class="entradilla">
        Si necesitas asesoramiento profesional o quieres saber exactamente en manos de quién estás
        dejando el acceso a tu propiedad, aquí nos tienes. Estamos a tu disposición con la cercanía y
        el rigor de siempre.
      </p>
      <BotonLlamar cta="telefono-quienes-somos" clase="cierre__boton" />
    </div>
  </section>

  <CtaFinal arriba="var(--papel)" />
</Layout>

<style>
  .historia {
    padding-top: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .historia__titulo {
    margin-top: 1.25rem;
    max-width: 16ch;
    font-size: clamp(2.6rem, 1.3rem + 5vw, 6rem);
    line-height: 0.98;
  }

  .historia__rejilla {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  @media (min-width: 960px) {
    .historia__rejilla {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr);
      gap: 5rem;
    }
  }

  .historia__cita {
    margin: 0;
    padding-top: 1.5rem;
    border-top: 2px solid var(--tinta);
  }

  .historia__cita p {
    font-family: var(--f-display);
    font-size: clamp(1.7rem, 1.2rem + 1.8vw, 2.6rem);
    font-style: italic;
    font-weight: 330;
    line-height: 1.2;
    color: var(--laton-texto);
  }

  .historia__cita p::before {
    content: '“';
    display: block;
    height: 0.55em;
    font-size: 2.4em;
    line-height: 1;
    color: var(--laton);
  }

  .equipo {
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .equipo__rejilla {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 960px) {
    .equipo__rejilla {
      grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr);
      gap: 5rem;
    }
  }

  .equipo__numero {
    font-family: var(--f-display);
    font-size: clamp(6rem, 4rem + 8vw, 11rem);
    font-style: italic;
    font-weight: 300;
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: var(--laton);
  }

  .equipo__numero span {
    font-size: 0.5em;
    vertical-align: top;
  }

  .equipo__leyenda {
    margin-top: 1rem;
    max-width: 16rem;
    font-family: var(--f-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--cromo);
  }

  .equipo__logo {
    width: 14rem;
    margin-top: 2.5rem;
  }

  .equipo__valores {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12.5rem), 1fr));
  }

  .equipo__valores .etiqueta h2 {
    font-size: 1.35rem;
  }

  .cierre {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .cierre {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 5rem;
    }
  }

  .cierre :global(.figura) {
    max-width: 30rem;
  }

  .cierre__texto :global(.cierre__boton) {
    margin-top: 2rem;
  }
</style>
