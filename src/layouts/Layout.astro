---
import '@/styles/global.css';

import SEO from '@components/SEO.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import MobileStickyCall from '@components/MobileStickyCall.astro';

interface Props {
  titulo: string;
  descripcion: string;
  ruta: string;
  imagen?: string;
  imagenAlt?: string;
  noindex?: boolean;
  /** Bloques JSON-LD adicionales (Service, BreadcrumbList…) */
  schemas?: unknown[];
}

const { titulo, descripcion, ruta, imagen, imagenAlt, noindex = false, schemas = [] } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#030712" />
    <meta name="format-detection" content="telephone=yes" />

    <SEO titulo={titulo} descripcion={descripcion} ruta={ruta} imagen={imagen} imagenAlt={imagenAlt} noindex={noindex} />

    <!-- Solo se precarga la fuente de los titulares (spec §24) -->
    <link rel="preload" href="/fuentes/michroma-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>

  <body>
    <a href="#contenido" class="saltar">Saltar al contenido</a>

    <Header ruta={ruta} />

    <main id="contenido">
      <slot />
    </main>

    <Footer />
    <MobileStickyCall />

    <script>
      import '@lib/track.ts';
    </script>

    <style>
      .saltar {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 300;
        padding: 0.6rem 1rem;
        font-weight: 700;
        color: var(--obsidiana-profunda);
        background: var(--oro);
        border-radius: 0.4rem;
        transform: translateY(-200%);
      }

      .saltar:focus {
        transform: none;
      }
    </style>
  </body>
</html>
