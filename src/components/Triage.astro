---
/**
 * Triaje «¿Qué te ha pasado?» (spec §39). HTML estático con <details>: se
 * rastrea, es accesible y funciona sin JavaScript. El atributo name hace que
 * solo haya una situación abierta a la vez en los navegadores que lo admiten.
 */
import CallButton from '@components/CallButton.astro';
import Icono from '@components/ui/Icono.astro';
import { situaciones } from '@data/situaciones';
---

<section class="triaje tramo" id="que-te-ha-pasado" aria-labelledby="triaje-titulo">
  <div class="envoltura">
    <p class="rotulo">Empieza por aquí</p>
    <h2 class="seccion__titulo" id="triaje-titulo">¿Qué te ha pasado?</h2>
    <p class="seccion__entrada">Elige tu situación: te decimos qué hacer ahora y qué haremos nosotros.</p>

    <div class="triaje__lista">
      {
        situaciones.map((s, i) => (
          <details class="situacion" name="triaje" id={`situacion-${s.id}`} open={i === 0}>
            <summary>
              <span class="situacion__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="situacion__titulo">
                <b>{s.titulo}</b>
                <small>{s.detalle}</small>
              </span>
              <span class="situacion__flecha" aria-hidden="true">
                <Icono nombre="flecha" tam={20} />
              </span>
            </summary>

            <div class="situacion__cuerpo">
              <div class="situacion__bloques">
                <div>
                  <h3>Qué hacer ahora</h3>
                  <ul>{s.ahora.map((t) => <li>{t}</li>)}</ul>
                </div>
                <div>
                  <h3>Qué haremos nosotros</h3>
                  <ul>{s.haremos.map((t) => <li>{t}</li>)}</ul>
                </div>
                <div>
                  <h3>Qué tener a mano</h3>
                  <ul>{s.aMano.map((t) => <li>{t}</li>)}</ul>
                </div>
              </div>

              <div class="situacion__acciones">
                <CallButton cta={`triage-${s.id}`} />
                <a class="enlace" href={s.servicio.href}>
                  {s.servicio.texto} →
                </a>
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .triaje {
    background:
      radial-gradient(60rem 30rem at 90% 0%, rgb(212 175 55 / 0.07), transparent 60%),
      var(--obsidiana);
  }

  .triaje__lista {
    display: grid;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .situacion {
    background: rgb(255 255 255 / 0.03);
    border: 1px solid var(--linea);
    border-radius: 1rem;
    transition: border-color 0.25s ease;
  }

  .situacion[open] {
    border-color: var(--linea-oro);
    background: rgb(212 175 55 / 0.04);
  }

  summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    list-style: none;
    cursor: pointer;
    border-radius: 1rem;
  }

  .situacion__num {
    font-family: var(--f-marca);
    font-size: 0.8rem;
    color: var(--oro);
  }

  .situacion__titulo b {
    display: block;
    font-size: clamp(1.08rem, 1rem + 0.4vw, 1.3rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--blanco);
  }

  .situacion__titulo small {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.9rem;
    color: var(--plata-2);
  }

  .situacion__flecha {
    color: var(--oro);
    transition: transform 0.3s ease;
  }

  .situacion[open] .situacion__flecha {
    transform: rotate(90deg);
  }

  .situacion__cuerpo {
    padding: 0.25rem 1.25rem 1.5rem;
  }

  .situacion__bloques {
    display: grid;
    gap: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--linea);
  }

  @media (min-width: 860px) {
    .situacion__bloques {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .situacion h3 {
    font-family: var(--f-marca);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--oro);
  }

  .situacion ul {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .situacion li {
    position: relative;
    padding-left: 1.2rem;
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--plata);
  }

  .situacion li + li {
    margin-top: 0.5rem;
  }

  .situacion li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--oro);
  }

  .situacion__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 1.75rem;
  }
</style>
