---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={tam}
  height={tam}
  viewBox="0 0 24 24"
  fill={relleno ? 'currentColor' : 'none'}
  stroke={relleno ? 'none' : 'currentColor'}
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={clase || undefined}
  aria-hidden="true"
  focusable="false"
  set:html={trazos[nombre]}
/>
