---
import Icono from '@components/ui/Icono.astro';
---

<button type="button" id="boton-arriba" class="arriba no-imprimir" aria-label="Volver arriba" hidden>
  <Icono nombre="flecha-arriba" tam={18} />
</button>

<style>
  .arriba {
    position: fixed;
    right: 1rem;
    bottom: 5.75rem;
    z-index: 65;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--laton);
    background: var(--tinta);
    border: 1px solid rgb(214 163 40 / 0.5);
    border-radius: 50%;
    cursor: pointer;
  }

  .arriba[hidden] {
    display: none;
  }

  @media (min-width: 1100px) and (min-height: 700px) {
    .arriba {
      bottom: 1.5rem;
      right: 1.5rem;
    }
  }
</style>

<script>
  const boton = document.getElementById('boton-arriba');
  if (boton) {
    const alternar = () => {
      boton.hidden = window.scrollY < 700;
    };
    addEventListener('scroll', alternar, { passive: true });
    alternar();
    boton.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));
  }
</script>
