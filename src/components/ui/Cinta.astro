---
interface Props {
  frases: string[];
}

const { frases } = Astro.props;
---

<div class="cinta" aria-hidden="true">
  <div class="cinta__pista">
    {
      [0, 1].map(() => (
        <span class="cinta__tramo">
          {frases.map((f) => (
            <>
              <span class="cinta__frase">{f}</span>
              <svg class="cinta__llave" viewBox="0 0 40 16" width="40" height="16">
                <circle cx="7" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="2" />
                <path d="M12.5 8H38v3h-3v3h-4v-3h-3v4h-4v-4h-3" fill="none" stroke="currentColor" stroke-width="2" />
              </svg>
            </>
          ))}
        </span>
      ))
    }
  </div>
</div>

<style>
  .cinta {
    overflow: hidden;
    padding-block: 1.1rem;
    color: var(--papel);
    background: var(--tinta);
    border-block: 1px solid rgb(214 163 40 / 0.35);
  }

  .cinta__pista {
    display: flex;
    width: max-content;
    animation: desfile 48s linear infinite;
  }

  .cinta:hover .cinta__pista {
    animation-play-state: paused;
  }

  .cinta__tramo {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-right: 2rem;
  }

  .cinta__frase {
    font-family: var(--f-display);
    font-size: clamp(1.35rem, 1rem + 1.4vw, 2.1rem);
    font-style: italic;
    font-weight: 340;
    white-space: nowrap;
  }

  .cinta__frase:nth-child(4n + 1) {
    color: var(--laton);
  }

  .cinta__llave {
    flex: none;
    color: var(--laton);
  }

  @keyframes desfile {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cinta__pista {
      animation: none;
    }
  }
</style>
