---
import Icono from '@components/ui/Icono.astro';
import { empresa, telHref } from '@data/empresa';

interface Props {
  texto?: string;
  sub?: string;
  variante?: 'laton' | 'tinta';
  cta: string;
  clase?: string;
}

const {
  texto = `Llamar al ${empresa.telefono}`,
  sub = '24 horas · 365 días',
  variante = 'laton',
  cta,
  clase,
} = Astro.props;
---

<a href={telHref} class:list={['llave', variante === 'tinta' && 'llave--tinta', clase]} data-cta={cta}>
  <span class="llave__cabeza"><Icono nombre="telefono" tam={20} /></span>
  <span class="llave__texto">
    {texto}
    {sub && <small>{sub}</small>}
  </span>
</a>
