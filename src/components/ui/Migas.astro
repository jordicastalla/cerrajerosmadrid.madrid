---
interface Props {
  items: { nombre: string; ruta: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Migas de pan" class="migas envoltura">
  <ol>
    {
      items.map((item, i) => (
        <li>
          {i === items.length - 1 ? (
            <span aria-current="page">{item.nombre}</span>
          ) : (
            <a href={item.ruta}>{item.nombre}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .migas {
    padding-top: 1.5rem;
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--suave);
  }

  li + li::before {
    content: '/';
    margin-right: 0.6rem;
    color: var(--laton-texto);
  }

  a {
    text-decoration: none;
  }

  a:hover {
    color: var(--cobalto);
  }

  [aria-current] {
    color: var(--tinta);
  }
</style>
