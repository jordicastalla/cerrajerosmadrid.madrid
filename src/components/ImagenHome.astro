---
/**
 * Hueco para una foto de la Home (v2.5). Si existe src/assets/home/imagen-<n>.*,
 * la pinta optimizada; si no, un detalle del perfil de Madrid en oro, con la
 * misma proporción, para que el diseño no cambie al llegar la foto.
 * Con `credito`, añade debajo un pie que acredita que la foto es del equipo.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { imagenesHome } from '@data/home';

interface Props {
  n: 1 | 2;
  clase?: string;
  /** Pie que acredita la autoría de la foto (E-E-A-T); solo si hay foto real */
  credito?: string;
}

const { n, clase = '', credito } = Astro.props;

const archivos = import.meta.glob<{ default: ImageMetadata }>('../assets/home/imagen-*.{webp,jpg,jpeg,png,avif}', {
  eager: true,
});
// imagen-<n>.ext o imagen-<n>-nombre-descriptivo.ext (el nombre del archivo también lo lee Google)
const clave = Object.keys(archivos).find((k) => new RegExp(`/imagen-${n}(-[a-z0-9-]+)?\\.[a-z]+$`).test(k));
const foto = clave ? archivos[clave].default : null;
const alt = imagenesHome[n].alt.trim();

if (foto && !alt)
  throw new Error(`Falta el texto alternativo de la imagen ${n} de la Home: escríbelo en src/data/home.ts (spec §8).`);
---

{
  foto ? (
    <figure class={`imagen-home-fig ${clase}`}>
      <Image src={foto} alt={alt} widths={[480, 800, 1200]} sizes="(min-width: 960px) 34rem, 100vw" class="imagen-home" />
      {credito && <figcaption class="credito imagen-home-credito">{credito}</figcaption>}
    </figure>
  ) : (
    <div class={`imagen-home imagen-home--hueco imagen-home--${n} ${clase}`} aria-hidden="true" />
  )
}

<style>
  .imagen-home-fig {
    margin: 0;
  }

  .imagen-home {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 1rem;
    border: 1px solid var(--linea-oro);
    box-shadow: 0 30px 60px -40px rgb(3 7 18 / 0.7);
  }

  .imagen-home-credito {
    margin-top: 0.6rem;
    text-align: center;
  }

  /* Sin foto: un detalle del perfil de Madrid, en oro sobre obsidiana */
  .imagen-home--hueco {
    background:
      url('../assets/marca/skyline.webp') no-repeat,
      radial-gradient(28rem 18rem at 50% 80%, rgb(212 175 55 / 0.16), transparent 70%),
      var(--obsidiana-profunda);
  }

  /* Hueco 1: la cúpula del Metrópolis con la Victoria; hueco 2: los edificios de la derecha */
  .imagen-home--1 {
    background-size: 290% auto, auto, auto;
    background-position: 14% 72%, center, center;
  }

  .imagen-home--2 {
    background-size: 260% auto, auto, auto;
    background-position: 88% 100%, center, center;
  }
</style>
