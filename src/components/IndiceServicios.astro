---
import { servicios } from '@data/servicios';

const filas = [
  {
    href: '#urgencias',
    nombre: 'Apertura de puertas 24 h',
    resumen:
      'Urgencias y emergencias de apertura sin daños innecesarios en la estructura ni en la carpintería.',
    imagen: '/cerrajeria-urgencia-chamartin.webp',
  },
  ...servicios.map((s) => ({ href: `/${s.slug}/`, nombre: s.nombre, resumen: s.resumen, imagen: s.imagen })),
];
---

<section class="indice tramo" aria-labelledby="indice-titulo">
  <div class="envoltura">
    <div class="indice__cabeza">
      <p class="rotulo">Índice de servicios</p>
      <h2 id="indice-titulo">Lo que hacemos <em>en Chamartín</em></h2>
    </div>

    <ol class="indice__lista">
      {
        filas.map((f, i) => (
          <li>
            <a href={f.href} class="indice__fila">
              <span class="indice__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="indice__nombre">{f.nombre}</span>
              <span class="indice__resumen">{f.resumen}</span>
              <span class="indice__foto" aria-hidden="true">
                <img src={f.imagen} alt="" width="480" height="334" loading="lazy" decoding="async" />
              </span>
              <span class="indice__flecha" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .indice {
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .indice__cabeza h2 {
    margin-top: 1rem;
    font-size: clamp(2.2rem, 1.4rem + 3vw, 4.2rem);
  }

  .indice__lista {
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--tinta);
  }

  .indice__fila {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: 0.4rem 1rem;
    align-items: baseline;
    padding: 1.5rem 0.25rem;
    text-decoration: none;
    border-bottom: 1px solid var(--linea);
    background: linear-gradient(var(--tinta), var(--tinta)) 0 0 / 0% 100% no-repeat;
    transition:
      background-size 0.5s cubic-bezier(0.3, 0.7, 0.2, 1),
      color 0.3s ease,
      padding 0.5s cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  .indice__num {
    grid-row: span 2;
    font-family: var(--f-mono);
    font-size: 0.75rem;
    color: var(--laton-texto);
  }

  .indice__nombre {
    font-family: var(--f-display);
    font-size: clamp(1.6rem, 1.1rem + 2vw, 2.8rem);
    font-weight: 440;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .indice__resumen {
    grid-column: 2 / 4;
    max-width: 34rem;
    font-size: 0.9688rem;
    color: var(--suave);
  }

  .indice__flecha {
    grid-column: 3;
    grid-row: 1;
    font-family: var(--f-mono);
    font-size: 1.4rem;
    transition: transform 0.35s ease;
  }

  .indice__foto {
    display: none;
  }

  @media (min-width: 900px) {
    .indice__fila {
      grid-template-columns: 3.5rem minmax(0, 1.15fr) minmax(0, 1fr) 9.5rem 2.5rem;
      align-items: center;
      gap: 2rem;
      padding-block: 1.9rem;
    }

    .indice__num {
      grid-row: auto;
    }

    .indice__resumen {
      grid-column: auto;
    }

    .indice__flecha {
      grid-column: auto;
      grid-row: auto;
    }

    .indice__foto {
      display: block;
      overflow: hidden;
      border-radius: 0.3rem;
      clip-path: inset(50% 0 50% 0);
      transition: clip-path 0.5s cubic-bezier(0.3, 0.7, 0.2, 1);
    }

    .indice__foto img {
      aspect-ratio: 16 / 10;
      object-fit: cover;
    }
  }

  @media (hover: hover) {
    .indice__fila:hover {
      background-size: 100% 100%;
      color: var(--papel);
      padding-inline: 1.25rem;
    }

    .indice__fila:hover .indice__nombre {
      font-style: italic;
      color: var(--laton);
    }

    .indice__fila:hover .indice__resumen {
      color: var(--cromo);
    }

    .indice__fila:hover .indice__num {
      color: var(--laton);
    }

    .indice__fila:hover .indice__foto {
      clip-path: inset(0 0 0 0);
    }

    .indice__fila:hover .indice__flecha {
      transform: translateX(0.4rem);
      color: var(--laton);
    }
  }

  .indice__fila:focus-visible {
    outline-offset: -3px;
  }
</style>
