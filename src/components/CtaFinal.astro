---
import CallButton from '@components/CallButton.astro';
import Emblema from '@components/marca/Emblema.astro';

interface Props {
  titulo?: string;
  texto?: string;
  cta?: string;
}

const {
  titulo = '¿Necesitas un cerrajero ahora?',
  texto = 'Llámanos y cuéntanos qué ha pasado. Servicio 24 horas, también de noche y en festivos.',
  cta = 'cta-final',
} = Astro.props;
---

<section class="final tramo tramo--profundo">
  <div class="envoltura final__rejilla">
    <Emblema tam={150} clase="final__emblema" />
    <div>
      <h2 class="final__titulo">{titulo}</h2>
      <p class="final__texto">{texto}</p>
      <CallButton cta={cta} sub="24 horas" clase="final__boton" />
    </div>
  </div>
</section>

<style>
  .final {
    background:
      radial-gradient(40rem 22rem at 20% 50%, rgb(212 175 55 / 0.12), transparent 65%),
      var(--obsidiana-profunda);
    border-top: 1px solid var(--linea-oro);
  }

  .final__rejilla {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 760px) {
    .final__rejilla {
      grid-template-columns: auto 1fr;
      gap: 3.5rem;
    }
  }

  :global(.final__emblema) {
    width: clamp(110px, 18vw, 170px);
    height: auto;
    filter: drop-shadow(0 0 30px rgb(212 175 55 / 0.25));
  }

  .final__titulo {
    font-size: clamp(1.9rem, 1.3rem + 2.2vw, 3rem);
  }

  .final__texto {
    margin-top: 0.9rem;
    max-width: 34rem;
    font-size: 1.125rem;
    color: var(--plata-2);
  }

  :global(.final__boton) {
    margin-top: 1.75rem;
  }
</style>
