---
/**
 * Emblema del cliente: la Victoria Alada con la llave, dentro del aro dorado.
 * Original en src/assets/marca/emblema.webp (fondo transparente).
 */
import { Image } from 'astro:assets';
import emblema from '@/assets/marca/emblema.webp';

interface Props {
  /** Ancho de referencia en px (se generan 1x y 2x) */
  tam?: number;
  clase?: string;
  /** Texto alternativo; si falta, el emblema es decorativo */
  titulo?: string;
  carga?: 'lazy' | 'eager';
}

const { tam = 64, clase = '', titulo, carga = 'lazy' } = Astro.props;
---

<Image
  src={emblema}
  alt={titulo ?? ''}
  width={tam}
  densities={[1, 2]}
  class={clase || undefined}
  loading={carga}
/>
