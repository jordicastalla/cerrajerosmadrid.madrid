  viewBox="0 0 1200 140"
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="skyline-oro" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#D4AF37" stop-opacity="0.55" />
      <stop offset="1" stop-color="#D4AF37" stop-opacity="0.08" />
