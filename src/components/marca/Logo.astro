---
/**
 * Logotipo definitivo del cliente: Victoria Alada con la llave y el rótulo
 * «Cerrajeros Madrid OpenServi». Horizontal en la cabecera y vertical en el
 * pie. Originales en src/assets/marca/ (fondo transparente).
 */
import { Image } from 'astro:assets';
import horizontal from '@/assets/marca/logo-horizontal.webp';
import vertical from '@/assets/marca/logo-vertical.webp';
import { site } from '@data/site';

interface Props {
  variante?: 'barra' | 'grande';
  /** Texto alternativo; vacío si el enlace que lo envuelve ya lleva nombre */
  alt?: string;
}

const { variante = 'barra', alt = site.nombre } = Astro.props;
const barra = variante === 'barra';
---

{
  barra ? (
    <Image src={horizontal} alt={alt} height={54} densities={[1, 2]} class="logo logo--barra" loading="eager" />
  ) : (
    <Image src={vertical} alt={alt} width={220} densities={[1, 2]} class="logo logo--grande" />
  )
}

<style>
  .logo {
    display: block;
    width: auto;
  }

  .logo--barra {
    height: clamp(2.75rem, 2.2rem + 2vw, 3.4rem);
  }

  .logo--grande {
    width: min(13.75rem, 60vw);
    height: auto;
  }
</style>
