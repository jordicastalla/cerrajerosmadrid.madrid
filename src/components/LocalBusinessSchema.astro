---
/**
 * Entidad completa del negocio en JSON-LD (spec §14) y el sitio web (WebSite,
 * para el nombre del sitio en Google). Solo en la Home; el resto de páginas
 * referencian el negocio por @id.
 */
import { negocio, sitioWeb } from '@lib/schema';

interface Props {
  zonasReady: string[];
}

const { zonasReady } = Astro.props;
---

<script type="application/ld+json" set:html={JSON.stringify(sitioWeb())} />
<script type="application/ld+json" set:html={JSON.stringify(negocio(zonasReady))} />
