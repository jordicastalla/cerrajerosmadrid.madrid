---
/**
 * Migas de pan discretas + BreadcrumbList en JSON-LD (spec §10). Sin páginas
 * de servicios ni de zonas (v2.2): Inicio › página actual. El último tramo no
 * enlaza.
 */
import { migas, type Miga } from '@lib/schema';

interface Props {
  items: Miga[];
}

const { items } = Astro.props;
---

<nav class="migas envoltura" aria-label="Migas de pan">
  <ol>
    {
      items.map((item, i) => (
        <li>
          {i < items.length - 1 ? <a href={item.ruta}>{item.nombre}</a> : <span aria-current="page">{item.nombre}</span>}
        </li>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(migas(items))} />

<style>
  .migas {
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--linea);
  }

  .migas ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.8rem;
    letter-spacing: 0.01em;
    color: var(--plata-2);
  }

  .migas li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .migas li + li::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1.5px solid var(--oro);
    border-top: 1.5px solid var(--oro);
    transform: rotate(45deg);
    opacity: 0.8;
  }

  .migas a {
    color: var(--plata);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .migas a:hover {
    color: var(--oro);
  }

  .migas [aria-current] {
    font-weight: 600;
    color: var(--oro);
  }
</style>
