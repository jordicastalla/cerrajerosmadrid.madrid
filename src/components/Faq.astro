---
/**
 * Preguntas frecuentes en HTML visible (spec §6). Sin marcado FAQPage: no
 * aporta resultados visibles en Google (spec §14).
 */
import { site, telHref } from '@data/site';

export interface PreguntaFaq {
  p: string;
  r: string;
}

interface Props {
  faqs: PreguntaFaq[];
  titulo?: string;
  id?: string;
}

const { faqs, titulo = 'Preguntas frecuentes', id = 'faq' } = Astro.props;
---

{
  faqs.length > 0 && (
    <section class="faq tramo claro" id={id} aria-labelledby={`${id}-titulo`}>
      <div class="envoltura faq__rejilla">
        <div class="faq__cabeza">
          <p class="rotulo">Dudas habituales</p>
          <h2 class="seccion__titulo" id={`${id}-titulo`}>
            {titulo}
          </h2>
          <p class="faq__nota">
            ¿Tu caso no está aquí? Llama al{' '}
            <a href={telHref} data-cta="faq">
              {site.telefono}
            </a>{' '}
            y lo hablamos.
          </p>
        </div>

        <div class="faq__lista">
          {faqs.map((f) => (
            <details class="faq__item">
              <summary>
                <h3>{f.p}</h3>
                <svg class="faq__llave" viewBox="0 0 44 18" width="44" height="18" aria-hidden="true">
                  <circle cx="8" cy="9" r="6" />
                  <path d="M14 9h28v3.5h-3.5V16h-4v-3.5h-3V17h-4v-4.5h-3" />
                </svg>
              </summary>
              <p>{f.r}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .faq__rejilla {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 960px) {
    .faq__rejilla {
      grid-template-columns: minmax(16rem, 0.8fr) minmax(0, 1.5fr);
      gap: 5rem;
    }

    .faq__cabeza {
      position: sticky;
      top: 6.5rem;
      align-self: start;
    }
  }

  .faq__nota {
    margin-top: 1.25rem;
    max-width: 24rem;
    color: var(--pizarra);
  }

  .faq__nota a {
    font-weight: 800;
    color: var(--obsidiana);
    white-space: nowrap;
  }

  .faq__lista {
    border-top: 2px solid var(--obsidiana);
  }

  .faq__item {
    border-bottom: 1px solid var(--linea-clara);
  }

  summary {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.3rem 0;
    list-style: none;
    cursor: pointer;
  }

  summary h3 {
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    font-weight: 700;
    line-height: 1.3;
  }

  .faq__llave {
    fill: none;
    stroke: var(--obsidiana);
    stroke-width: 2;
    stroke-linejoin: round;
    transform-origin: 8px 9px;
    transition: transform 0.45s cubic-bezier(0.3, 0.7, 0.2, 1.3);
  }

  /* Al abrir la pregunta, la llave gira como en la cerradura */
  details[open] .faq__llave {
    transform: rotate(90deg);
    stroke: var(--oro-texto);
  }

  details p {
    max-width: 40rem;
    padding: 0 3.5rem 1.5rem 0;
    line-height: 1.7;
    color: var(--pizarra);
  }
</style>
