---
/**
 * Mapa de Google, cargado solo cuando el visitante lo pide: un iframe de
 * Maps trae varios cientos de kilobytes y contacta con Google —con sus
 * cookies— en cuanto se abre la página, y este sitio no usa ningún otro
 * servicio de terceros. Lo que se pinta de entrada es un marcador propio,
 * sin peso; el iframe se inserta al pulsar el botón.
 */
import Icono from '@components/ui/Icono.astro';
import { empresa } from '@data/empresa';

interface Props {
  titulo?: string;
  alto?: number;
}

const { titulo = 'Dónde trabajamos', alto = 420 } = Astro.props;
---

<section class="mapa tramo">
  <div class="envoltura">
    <p class="rotulo">Ubicación</p>
    <h2 class="mapa__titulo">{titulo}</h2>
    <p class="mapa__texto">
      Trabajamos en todo el distrito de Chamartín (Madrid). Puedes ver nuestra ficha de Google o abrir
      el mapa aquí mismo.
    </p>

    <div id="mapa-google" class="mapa__caja" style={`min-height:${alto}px`}>
      <p class="mapa__aviso-titulo">Mapa de Google</p>
      <p class="mapa__aviso">
        Al abrirlo, Google recibe tu dirección IP e instala sus cookies. Por eso no se carga solo:
        se abre únicamente si tú lo pides.
      </p>

      <button type="button" class="llave" data-abrir-mapa>
        <span class="llave__cabeza"><Icono nombre="mapa" tam={20} /></span>
        <span class="llave__texto">Ver el mapa</span>
      </button>

      <a href={empresa.fichaGoogle} target="_blank" rel="noopener" class="enlace">
        Abrir la ficha en Google Maps ↗
      </a>
    </div>
  </div>
</section>

<style>
  .mapa__titulo {
    margin-top: 1rem;
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
  }

  .mapa__texto {
    margin-top: 1rem;
    max-width: 38rem;
    color: var(--suave);
  }

  .mapa__caja {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 2rem;
    padding: 3rem 1.5rem;
    text-align: center;
    color: var(--papel);
    background:
      radial-gradient(circle at 50% 45%, rgb(214 163 40 / 0.18), transparent 55%),
      repeating-linear-gradient(0deg, transparent 0 39px, var(--linea-clara) 39px 40px),
      repeating-linear-gradient(90deg, transparent 0 39px, var(--linea-clara) 39px 40px),
      var(--tinta);
    border-radius: 0.4rem;
  }

  .mapa__caja.abierto {
    display: block;
    padding: 0;
    background: none;
  }

  .mapa__aviso-titulo {
    font-family: var(--f-display);
    font-size: 1.6rem;
  }

  .mapa__aviso {
    max-width: 28rem;
    color: var(--cromo);
    font-size: 0.9375rem;
  }
</style>

<script is:inline define:vars={{ EMBED: empresa.mapaEmbed, ALTO: alto, NOMBRE: empresa.nombre }}>
  (function () {
    var caja = document.getElementById('mapa-google');
    if (!caja) return;
    var boton = caja.querySelector('[data-abrir-mapa]');
    if (!boton) return;

    boton.addEventListener('click', function () {
      var marco = document.createElement('iframe');
      marco.src = EMBED;
      marco.title = 'Mapa de la ubicación de ' + NOMBRE;
      marco.loading = 'lazy';
      marco.referrerPolicy = 'strict-origin-when-cross-origin';
      marco.setAttribute('allowfullscreen', '');
      marco.style.cssText = 'display:block;width:100%;height:' + ALTO + 'px;border:0';

      caja.replaceChildren(marco);
      caja.classList.add('abierto');
      marco.focus();
    });
  })();
</script>
