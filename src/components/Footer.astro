---
/**
 * Pie (spec §22). Sin mapa: el mapa solo va en la Home y en el hub de zonas.
 * Las localidades solo se enlazan si están en ready (spec §5).
 */
import { getCollection } from 'astro:content';
import Logo from '@components/marca/Logo.astro';
import Skyline from '@components/marca/Skyline.astro';
import { site, telHref } from '@data/site';

const servicios = (await getCollection('servicios', (s) => s.data.status === 'ready')).sort((a, b) => a.data.orden - b.data.orden);
const zonas = (await getCollection('localidades', (l) => l.data.status === 'ready')).sort((a, b) =>
  a.data.nombre.localeCompare(b.data.nombre, 'es'),
);

const anio = new Date().getFullYear();
const l = site.legal;
---

<footer class="pie no-imprimir">
  <Skyline clase="pie__skyline" />
  <div class="envoltura">
    <div class="pie__rejilla">
      <div class="pie__marca">
        <Logo variante="grande" />
        <p>
          Cerrajería 24 horas en Madrid. En las zonas de alrededor, uno de nuestros cerrajeros trabaja en la
          propia zona.
        </p>
        <a href={telHref} class="pie__tel" data-cta="footer">{site.telefono}</a>
      </div>

      <nav class="pie__col" aria-label="Servicios">
        <p class="pie__rotulo">Servicios</p>
        <ul>
          <li><a href="/#apertura-de-puertas">Apertura de puertas</a></li>
          {servicios.map((s) => <li><a href={`/servicios/${s.id}/`}>{s.data.titulo}</a></li>)}
          <li><a href="/#cerrajero-urgente-24-horas">Cerrajero urgente 24 horas</a></li>
        </ul>
      </nav>

      <nav class="pie__col" aria-label="Zonas">
        <p class="pie__rotulo">Zonas</p>
        <ul>
          <li><a href="/cerrajeros/">Zonas de servicio</a></li>
          {zonas.map((z) => <li><a href={`/cerrajeros/${z.id}/`}>Cerrajeros en {z.data.nombre}</a></li>)}
        </ul>
      </nav>

      <div class="pie__col">
        <p class="pie__rotulo">Contacto</p>
        <ul>
          <li><a href={telHref} data-cta="footer-contacto">Llamar al {site.telefono}</a></li>
          <li>{site.horario}</li>
          <li>
            <a href={site.perfilGoogle} target="_blank" rel="noopener" data-evento="perfil_google" data-cta="footer">
              Opiniones en Google ↗
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="pie__legal">
      <p>
        © {anio} {l.titular} · NIF {l.nif} · {l.calle}, {l.cp} {l.ciudad} ({l.provincia})
      </p>
      <ul>
        <li><a href="/aviso-legal/">Aviso legal</a></li>
        <li><a href="/politica-de-privacidad/">Privacidad</a></li>
        <li><a href="/politica-de-cookies/">Cookies</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .pie {
    position: relative;
    padding-bottom: 2rem;
    background: var(--obsidiana-profunda);
    border-top: 1px solid var(--linea-oro);
  }

  .pie__skyline {
    display: block;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .pie__rejilla {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 760px) {
    .pie__rejilla {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1100px) {
    .pie__rejilla {
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
      gap: 3rem;
    }
  }

  .pie__marca p {
    margin-top: 1.25rem;
    max-width: 22rem;
    font-size: 0.97rem;
    color: var(--plata-2);
  }

  .pie__tel {
    display: inline-block;
    margin-top: 1.25rem;
    font-family: var(--f-marca);
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    color: var(--oro);
    text-decoration: none;
  }

  .pie__rotulo {
    margin-bottom: 1rem;
    font-family: var(--f-marca);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--oro);
  }

  .pie ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pie__col li {
    font-size: 0.97rem;
    color: var(--plata-2);
  }

  .pie__col li + li {
    margin-top: 0.6rem;
  }

  .pie__col a {
    color: var(--plata);
    text-decoration: none;
    background: linear-gradient(var(--oro), var(--oro)) 0 100% / 0 1px no-repeat;
    transition: background-size 0.3s ease;
  }

  .pie__col a:hover {
    background-size: 100% 1px;
  }

  .pie__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--linea);
    font-size: 0.82rem;
    color: var(--plata-2);
  }

  .pie__legal ul {
    display: flex;
    gap: 1.5rem;
  }

  .pie__legal a {
    color: var(--plata);
  }
</style>
