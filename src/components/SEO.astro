---
/**
 * Metadatos de cada página (spec §11, §12, §26): title único, description,
 * canonical absoluto, robots según la puerta de indexación, Open Graph y X.
 * La 404 no lleva canonical ni og:url (no es una URL que se deba indexar).
 */
import { site, absoluta } from '@data/site';

interface Props {
  titulo: string;
  descripcion: string;
  ruta: string;
  imagen?: string;
  imagenAlt?: string;
  /** Medidas reales de la imagen OG (por defecto, las de la imagen general 1200×630) */
  imagenAncho?: number;
  imagenAlto?: number;
  noindex?: boolean;
  /** Sin canonical ni og:url (página de error) */
  sinCanonical?: boolean;
}

const {
  titulo,
  descripcion,
  ruta,
  imagen = site.imagenOg,
  imagenAlt,
  imagenAncho = 1200,
  imagenAlto = 630,
  noindex = false,
  sinCanonical = false,
} = Astro.props;

const canonical = absoluta(ruta);
const ogImagen = absoluta(imagen);
---

<title>{titulo}</title>
<meta name="description" content={descripcion} />
{!sinCanonical && <link rel="canonical" href={canonical} />}
{
  noindex ? (
    <meta name="robots" content="noindex, follow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  )
}
{site.verificacionGoogle && <meta name="google-site-verification" content={site.verificacionGoogle} />}

<meta property="og:type" content="website" />
<meta property="og:locale" content="es_ES" />
<meta property="og:site_name" content={site.nombre} />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descripcion} />
{!sinCanonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImagen} />
<meta property="og:image:width" content={String(imagenAncho)} />
<meta property="og:image:height" content={String(imagenAlto)} />
<meta property="og:image:alt" content={imagenAlt ?? `${site.nombre} · ${site.telefono}`} />
<meta name="twitter:card" content="summary_large_image" />
