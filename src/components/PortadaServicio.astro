---
import Migas from '@components/ui/Migas.astro';
import Figura from '@components/ui/Figura.astro';
import FichaTecnica from '@components/ui/FichaTecnica.astro';
import BotonLlamar from '@components/ui/BotonLlamar.astro';

interface Props {
  num: string;
  antetitulo: string;
  titulo: string;
  entrada: string;
  migas: { nombre: string; ruta: string }[];
  imagen: { src: string; alt: string; pie: string };
  ficha: { k: string; v: string }[];
}

const { num, antetitulo, titulo, entrada, migas, imagen, ficha } = Astro.props;
---

<div class="ps">
  <span class="ps__fondo" aria-hidden="true">{num}</span>
  <Migas items={migas} />

  <header class="envoltura ps__rejilla">
    <div class="ps__texto">
      <p class="rotulo">{antetitulo}</p>
      <h1 class="ps__titulo" set:html={titulo} />
      <p class="entradilla ps__entrada">{entrada}</p>
      <div class="ps__acciones">
        <BotonLlamar cta="telefono-portada-servicio" />
        <a href="#preguntas" class="enlace">Preguntas frecuentes ↓</a>
      </div>
    </div>

    <div class="ps__lateral">
      <Figura src={imagen.src} alt={imagen.alt} num="01" pie={imagen.pie} prioridad />
      <FichaTecnica filas={ficha} clase="ps__ficha" />
    </div>
  </header>
</div>

<style>
  .ps {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-bottom: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--linea);
  }

  /* Número del servicio en grande, solo contorno, detrás del titular */
  .ps__fondo {
    position: absolute;
    top: -0.12em;
    right: -0.04em;
    z-index: -1;
    font-family: var(--f-display);
    font-size: clamp(14rem, 30vw, 30rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--papel-3);
    user-select: none;
  }

  .ps__rejilla {
    display: grid;
    gap: 3rem;
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  @media (min-width: 1000px) {
    .ps__rejilla {
      grid-template-columns: minmax(0, 1.3fr) minmax(20rem, 0.7fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: end;
    }
  }

  .ps__titulo {
    margin-top: 1.25rem;
    font-size: clamp(2.3rem, 1.3rem + 3.6vw, 4.8rem);
    line-height: 1;
  }

  .ps__entrada {
    margin-top: 1.75rem;
    max-width: 40rem;
    color: var(--suave);
  }

  .ps__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 2.25rem;
  }

  .ps__lateral {
    max-width: 30rem;
  }

  .ps__lateral :global(.ps__ficha) {
    margin-top: 1.75rem;
    padding-top: 0.5rem;
    border-top: 2px solid var(--tinta);
  }
</style>
