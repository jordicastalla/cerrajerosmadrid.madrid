---
/**
 * Cabecera (spec §21): logo, navegación corta y teléfono. «Servicios» es un
 * desplegable con enlace directo a cada servicio (no hay página de servicios).
 * El menú se reduce a lo esencial: Servicios, Quiénes somos y Opiniones.
 * En móvil, menú en un <dialog> (sin dependencias).
 */
import { getCollection } from 'astro:content';
import Logo from '@components/marca/Logo.astro';
import CallButton from '@components/CallButton.astro';
import Icono from '@components/ui/Icono.astro';
import { site, telHref } from '@data/site';

interface Props {
  ruta: string;
}

const { ruta } = Astro.props;

const fichas = (await getCollection('servicios', (s) => s.data.status === 'ready')).sort((a, b) => a.data.orden - b.data.orden);

const servicios = [
  { href: '/#apertura-de-puertas', nombre: 'Apertura de puertas' },
  ...fichas.map((s) => ({ href: `/servicios/${s.id}/`, nombre: s.data.titulo })),
  { href: '/#cerrajero-urgente-24-horas', nombre: 'Cerrajero urgente 24 horas' },
];

const enlaces = [
  { href: '/quienes-somos/', nombre: 'Quiénes somos' },
  { href: '/opiniones/', nombre: 'Opiniones' },
];

const actual = (href: string) => (href === ruta ? 'page' : undefined);
const enServicio = ruta.startsWith('/servicios/');
---

<header class="cabecera no-imprimir">
  <div class="cabecera__fila envoltura">
    <a href="/" class="cabecera__marca" aria-label={`${site.nombre}, inicio`}>
      <Logo alt="" />
    </a>

    <nav class="cabecera__nav" aria-label="Principal">
      <ul>
        <li class="desplegable" data-desplegable>
          <button
            type="button"
            class:list={['desplegable__boton', { 'es-actual': enServicio }]}
            aria-expanded="false"
            aria-controls="submenu-servicios"
          >
            Servicios <span class="desplegable__flecha" aria-hidden="true"></span>
          </button>
          <ul class="desplegable__lista" id="submenu-servicios">
            {
              servicios.map((e) => (
                <li>
                  <a href={e.href} aria-current={actual(e.href)}>
                    {e.nombre}
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        {
          enlaces.map((e) => (
            <li>
              <a href={e.href} aria-current={actual(e.href)}>
                {e.nombre}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href={telHref} class="cabecera__tel" data-cta="header">
      <span class="cabecera__tel-icono"><Icono nombre="telefono" tam={18} /></span>
      <span class="cabecera__tel-num">{site.telefono}</span>
      <span class="solo-lector">Llamar</span>
    </a>

    <button type="button" class="cabecera__menu" aria-haspopup="dialog" aria-controls="menu" data-abrir-menu>
      <span class="cabecera__dientes" aria-hidden="true"><i></i><i></i><i></i></span>
      Menú
    </button>
  </div>
</header>

<dialog id="menu" class="menu" aria-label="Menú de navegación">
  <div class="menu__cabeza">
    <Logo />
    <button type="button" class="menu__cerrar" data-cerrar-menu>
      Cerrar <span aria-hidden="true">✕</span>
    </button>
  </div>

  <nav aria-label="Menú">
    <ul class="menu__lista">
      <li><a href="/" data-cerrar-menu>Inicio</a></li>
      <li>
        <p class="menu__grupo">Servicios</p>
        <ul class="menu__sub">
          {
            servicios.map((e) => (
              <li>
                <a href={e.href} aria-current={actual(e.href)} data-cerrar-menu>
                  {e.nombre}
                </a>
              </li>
            ))
          }
        </ul>
      </li>
      {
        enlaces.map((e) => (
          <li>
            <a href={e.href} aria-current={actual(e.href)} data-cerrar-menu>
              {e.nombre}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <CallButton cta="menu" sub="24 horas" clase="menu__llamar" />
</dialog>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgb(3 7 18 / 0.96);
    border-bottom: 1px solid var(--linea-oro);
  }

  .cabecera__fila {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.75rem;
  }

  .cabecera__marca {
    margin-right: auto;
    text-decoration: none;
  }

  .cabecera__nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .cabecera__nav {
      display: block;
    }
  }

  .cabecera__nav > ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cabecera__nav a,
  .desplegable__boton {
    display: block;
    padding: 0.6rem 0.85rem;
    white-space: nowrap;
    font-weight: 600;
    font-size: 0.97rem;
    color: var(--plata);
    text-decoration: none;
    border-radius: 999px;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .cabecera__nav a:hover,
  .cabecera__nav a[aria-current='page'],
  .desplegable__boton:hover,
  .desplegable__boton.es-actual,
  .desplegable__boton[aria-expanded='true'] {
    color: var(--oro);
    background: rgb(212 175 55 / 0.08);
  }

  /* --- Desplegable de servicios ------------------------------------- */
  .desplegable {
    position: relative;
  }

  .desplegable__boton {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: transparent;
    cursor: pointer;
  }

  .desplegable__flecha {
    width: 0.45rem;
    height: 0.45rem;
    margin-top: -0.2rem;
    border-right: 2px solid var(--oro);
    border-bottom: 2px solid var(--oro);
    transform: rotate(45deg);
    transition: transform 0.2s ease;
  }

  .desplegable__lista {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 70;
    display: none;
    min-width: 16.5rem;
    margin: 0.4rem 0 0;
    padding: 0.5rem;
    list-style: none;
    background: var(--obsidiana-profunda);
    border: 1px solid var(--linea-oro);
    border-radius: 0.9rem;
    box-shadow: 0 24px 48px -24px rgb(0 0 0 / 0.8);
  }

  /* Puente invisible: el ratón no pierde el menú al bajar del botón */
  .desplegable__lista::before {
    content: '';
    position: absolute;
    inset: -0.6rem 0 100%;
  }

  /* Sin JS se abre con el ratón o con el foco; con JS (data-js), con el ratón o con el botón */
  .desplegable:hover .desplegable__lista,
  .desplegable:not([data-js]):focus-within .desplegable__lista,
  .desplegable__boton[aria-expanded='true'] + .desplegable__lista {
    display: grid;
  }

  .desplegable:hover .desplegable__flecha,
  .desplegable__boton[aria-expanded='true'] .desplegable__flecha {
    transform: rotate(225deg);
    margin-top: 0.2rem;
  }

  .desplegable__lista a {
    padding: 0.65rem 0.85rem;
    border-radius: 0.6rem;
    white-space: nowrap;
  }

  .cabecera__tel {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0.3rem 1rem 0.3rem 0.3rem;
    font-family: var(--f-marca);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--blanco);
    text-decoration: none;
    border: 1px solid var(--linea-oro);
    border-radius: 999px;
    transition: border-color 0.2s ease;
  }

  .cabecera__tel:hover {
    border-color: var(--oro);
  }

  .cabecera__tel-num {
    white-space: nowrap;
  }

  /* Entre 1024 y 1200 px, el desplegable y los enlaces van más justos */
  @media (min-width: 1024px) and (max-width: 1199px) {
    .cabecera__fila {
      gap: 0.6rem;
    }

    .cabecera__nav a,
    .desplegable__boton {
      padding-inline: 0.6rem;
      font-size: 0.92rem;
    }

    .cabecera__tel {
      padding-right: 0.8rem;
      font-size: 0.78rem;
    }
  }

  .cabecera__tel-icono {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    color: var(--obsidiana-profunda);
    background: var(--grad-oro);
  }

  /* En móvil queda solo el icono: la barra fija ya lleva el número */
  @media (max-width: 639px) {
    .cabecera__tel {
      padding: 0.3rem;
      border: 0;
    }

    .cabecera__tel-num {
      display: none;
    }
  }

  .cabecera__menu {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0 1rem;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--plata);
    background: transparent;
    border: 1px solid var(--linea);
    border-radius: 999px;
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .cabecera__menu {
      display: none;
    }
  }

  .cabecera__dientes {
    display: grid;
    gap: 3px;
  }

  .cabecera__dientes i {
    display: block;
    height: 2px;
    background: var(--oro);
  }

  .cabecera__dientes i:nth-child(1) { width: 16px; }
  .cabecera__dientes i:nth-child(2) { width: 10px; }
  .cabecera__dientes i:nth-child(3) { width: 13px; }

  /* --- Menú a pantalla completa ------------------------------------ */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 1rem var(--margen) 2rem;
    color: var(--plata);
    background: var(--obsidiana-profunda);
    border: 0;
  }

  .menu[open] {
    display: flex;
    flex-direction: column;
    animation: entrar 0.3s cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  @keyframes entrar {
    from {
      opacity: 0;
      transform: translateY(-1rem);
    }
  }

  .menu::backdrop {
    background: rgb(3 7 18 / 0.7);
  }

  .menu__cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .menu__cerrar {
    min-height: 3rem;
    padding: 0 1rem;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--obsidiana-profunda);
    background: var(--oro);
    border-radius: 999px;
    cursor: pointer;
  }

  .menu__lista {
    margin: 2.5rem 0;
    padding: 0;
    list-style: none;
  }

  .menu__lista a {
    display: block;
    padding: 0.85rem 0;
    font-size: clamp(1.6rem, 7vw, 2.3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--blanco);
    text-decoration: none;
    border-bottom: 1px solid var(--linea);
  }

  .menu__lista a:hover,
  .menu__lista a[aria-current='page'] {
    color: var(--oro);
  }

  .menu__grupo {
    padding: 0.85rem 0 0.35rem;
    font-family: var(--f-marca);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--oro);
  }

  .menu__sub {
    margin: 0;
    padding: 0 0 0 1rem;
    list-style: none;
    border-left: 1px solid var(--linea-oro);
  }

  .menu__lista .menu__sub a {
    padding: 0.6rem 0;
    font-size: clamp(1.15rem, 5vw, 1.5rem);
    font-weight: 650;
  }

  :global(.menu__llamar) {
    align-self: flex-start;
    margin-top: auto;
  }
</style>

<script>
  const menu = document.getElementById('menu') as HTMLDialogElement | null;
  document.querySelector('[data-abrir-menu]')?.addEventListener('click', () => menu?.showModal());
  menu?.querySelectorAll('[data-cerrar-menu]').forEach((el) => el.addEventListener('click', () => menu.close()));

  // Desplegable de servicios: el botón lo abre y lo cierra; Esc o salir de él lo cierran
  for (const caja of document.querySelectorAll<HTMLElement>('[data-desplegable]')) {
    caja.dataset.js = '';
    const boton = caja.querySelector('button')!;
    const poner = (abierto: boolean) => boton.setAttribute('aria-expanded', String(abierto));
    boton.addEventListener('click', () => poner(boton.getAttribute('aria-expanded') !== 'true'));
    caja.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        poner(false);
        boton.focus();
      }
    });
    caja.addEventListener('focusout', (e) => {
      if (!caja.contains(e.relatedTarget as Node | null)) poner(false);
    });
    document.addEventListener('click', (e) => {
      if (!caja.contains(e.target as Node)) poner(false);
    });
  }
</script>
